# Debug: enable /consume_debug/<topic> endpoints (no Kafka required)
APILOGICPROJECT_CONSUME_DEBUG = true

SECRET_KEY = "whatnothow"
SQLALCHEMY_TRACK_MODIFICATIONS = False
SQLALCHEMY_ECHO = False
# AGGREGATE_DEFAULTS =  True
# ALL_DEFAULTS = True

# OPT_LOCKING controls the client-facing PATCH check: computing a checksum on GET, checking on PATCH
# the S_CheckSum the client echoes back is compared against the row's current on-disk checksum; mismatch = 409.
# Scoped to the row(s) the client actually fetched (nest_level == 0) - see TRANS_UPDATE_LOCKING
# below for the cascaded-update counterpart.
# ignored: no check performed
# optional (default): checked only if the client supplies S_CheckSum
# required: client must supply S_CheckSum, or the request is rejected
OPT_LOCKING = optional

# TRANS_UPDATE_LOCKING controls locking for LogicBank's own cascaded aggregate adjustments
# (Rule.sum/Rule.count parent updates) during a transaction - distinct from OPT_LOCKING above,
# which only covers the client's own PATCH. See internal_dev/locking_strategy.md.
# ignored (default): today's behavior, no locking
# pessimistic: locks the aggregate root row for the transaction duration (with_for_update)
TRANS_UPDATE_LOCKING = ignored

# Kafka examples (uncomment for live Kafka consume tests)
# Prefer a project-unique group name: <project>-group1 (for example: customs_demo-group1).
# Prefer KAFKA_SERVER + KAFKA_CONSUMER_GROUP for local tests.

# APILOGICPROJECT_KAFKA_CONSUMER is a FULL override via from_prefixed_env(); if set,
# include all keys and keep group.id aligned with KAFKA_CONSUMER_GROUP.
# Do not set conflicting values across these two sources.

# KAFKA_SERVER = localhost:9092
# KAFKA_CONSUMER_GROUP = <project>-group1
# APILOGICPROJECT_KAFKA_CONSUMER = "{\"bootstrap.servers\": \"localhost:9092\", \"group.id\": \"<project>-group1\", \"auto.offset.reset\": \"earliest\", \"enable.auto.commit\": \"false\", \"session.timeout.ms\": \"6000\", \"heartbeat.interval.ms\": \"2000\"}"
# APILOGICPROJECT_KAFKA_PRODUCER = "{\"bootstrap.servers\": \"localhost:9092\"}"

# SQLALCHEMY_DATABASE_URI=db.sqlite

SECURITY_ENABLED = false

# if using tunnel for mcp, function, or ai_plugin
# eg, https://tunnel_url.ngrok-free.app
API_LOGIC_SERVER_TUNNEL = "TUNNEL_URL"