Feature: Commissioned Employees # features/commissioned_employees.feature:1

  Scenario: Order raises commission_total and order_count                      # features/commissioned_employees.feature:3
    Given a department with budget 1000000                                     # features/steps/emp_types_steps.py:94
    And an employee of type commissioned with name="Comm Add" base_salary=1000 # features/steps/emp_types_steps.py:112
    When an order of 500 is added for the employee                             # features/steps/emp_types_steps.py:133
    Then the employee commission_total is 500                                  # features/steps/emp_types_steps.py:210
    And the employee order_count is 1                                          # features/steps/emp_types_steps.py:210
    And the employee salary is 1500                                            # features/steps/emp_types_steps.py:210

  Scenario: Order amount change adjusts commission_total                          # features/commissioned_employees.feature:11
    Given a department with budget 1000000                                        # features/steps/emp_types_steps.py:94
    And an employee of type commissioned with name="Comm Change" base_salary=1000 # features/steps/emp_types_steps.py:112
    And an order of 500 is added for the employee                                 # features/steps/emp_types_steps.py:133
    When the order amount is changed to 800                                       # features/steps/emp_types_steps.py:160
    Then the employee commission_total is 800                                     # features/steps/emp_types_steps.py:210
    And the employee salary is 1800                                               # features/steps/emp_types_steps.py:210

  Scenario: Deleting an order lowers commission_total and order_count             # features/commissioned_employees.feature:19
    Given a department with budget 1000000                                        # features/steps/emp_types_steps.py:94
    And an employee of type commissioned with name="Comm Delete" base_salary=1000 # features/steps/emp_types_steps.py:112
    And an order of 500 is added for the employee                                 # features/steps/emp_types_steps.py:133
    When the order is deleted                                                     # features/steps/emp_types_steps.py:184
    Then the employee commission_total is 0                                       # features/steps/emp_types_steps.py:210
    And the employee order_count is 0                                             # features/steps/emp_types_steps.py:210

  Scenario: Moving an order adjusts both employees                                 # features/commissioned_employees.feature:27
    Given a department with budget 1000000                                         # features/steps/emp_types_steps.py:94
    And an employee of type commissioned with name="Comm From" base_salary=1000    # features/steps/emp_types_steps.py:112
    And another employee of type commissioned with name="Comm To" base_salary=2000 # features/steps/emp_types_steps.py:119
    And an order of 500 is added for the employee                                  # features/steps/emp_types_steps.py:133
    When the order is moved to the other employee                                  # features/steps/emp_types_steps.py:172
    Then the employee commission_total is 0                                        # features/steps/emp_types_steps.py:210
    And the other employee commission_total is 500                                 # features/steps/emp_types_steps.py:205
    And the other employee order_count is 1                                        # features/steps/emp_types_steps.py:205

  Scenario: Base salary change adjusts salary                                   # features/commissioned_employees.feature:37
    Given a department with budget 1000000                                      # features/steps/emp_types_steps.py:94
    And an employee of type commissioned with name="Comm Base" base_salary=1000 # features/steps/emp_types_steps.py:112
    And an order of 500 is added for the employee                               # features/steps/emp_types_steps.py:133
    When the employee base_salary is changed to 2000                            # features/steps/emp_types_steps.py:148
    Then the employee salary is 2500                                            # features/steps/emp_types_steps.py:210

  Scenario: Salaried employee may not have orders                                   # features/commissioned_employees.feature:44
    Given a department with budget 1000000                                          # features/steps/emp_types_steps.py:94
    And an employee of type salaried with name="Order Sal" salary=1000              # features/steps/emp_types_steps.py:112
    When an order of 100 is added for the employee                                  # features/steps/emp_types_steps.py:133
    Then the request is rejected with "Only commissioned employees may have Orders" # features/steps/emp_types_steps.py:198

  Scenario: Hourly employee may not have base_salary                                                              # features/commissioned_employees.feature:50
    Given a department with budget 1000000                                                                        # features/steps/emp_types_steps.py:94
    When an employee of type hourly is created with name="Base Hour" hours_worked=1 hourly_rate=1 base_salary=100 # features/steps/emp_types_steps.py:126
    Then the request is rejected with "base_salary applies only to commissioned employees"                        # features/steps/emp_types_steps.py:198

Feature: Department Budget # features/department_budget.feature:1

  Scenario: Employee added to a department raises total_salary                    # features/department_budget.feature:3
    Given a department with budget 100000                                         # features/steps/emp_types_steps.py:94
    When an employee of type salaried is created with name="Add Emp" salary=40000 # features/steps/emp_types_steps.py:126
    Then the department total_salary is 40000                                     # features/steps/emp_types_steps.py:220

  Scenario: Salary change adjusts the department total                  # features/department_budget.feature:8
    Given a department with budget 100000                               # features/steps/emp_types_steps.py:94
    And an employee of type salaried with name="Raise Emp" salary=40000 # features/steps/emp_types_steps.py:112
    When the employee salary is changed to 55000                        # features/steps/emp_types_steps.py:148
    Then the department total_salary is 55000                           # features/steps/emp_types_steps.py:220

  Scenario: Deleting an employee lowers total_salary                     # features/department_budget.feature:14
    Given a department with budget 100000                                # features/steps/emp_types_steps.py:94
    And an employee of type salaried with name="Delete Emp" salary=40000 # features/steps/emp_types_steps.py:112
    When the employee is deleted                                         # features/steps/emp_types_steps.py:178
    Then the department total_salary is 0                                # features/steps/emp_types_steps.py:220

  Scenario: Moving an employee adjusts both departments                # features/department_budget.feature:20
    Given a department with budget 100000                              # features/steps/emp_types_steps.py:94
    And another department with budget 100000                          # features/steps/emp_types_steps.py:100
    And an employee of type salaried with name="Move Emp" salary=40000 # features/steps/emp_types_steps.py:112
    When the employee is moved to the other department                 # features/steps/emp_types_steps.py:166
    Then the department total_salary is 0                              # features/steps/emp_types_steps.py:220
    And the other department total_salary is 40000                     # features/steps/emp_types_steps.py:215

  Scenario: Total salary equal to the budget is accepted                               # features/department_budget.feature:28
    Given a department with budget 50000                                               # features/steps/emp_types_steps.py:94
    When an employee of type salaried is created with name="Boundary Emp" salary=50000 # features/steps/emp_types_steps.py:126
    Then the request is accepted                                                       # features/steps/emp_types_steps.py:192
    And the department total_salary is 50000                                           # features/steps/emp_types_steps.py:220

  Scenario: Total salary over the budget is rejected                               # features/department_budget.feature:34
    Given a department with budget 50000                                           # features/steps/emp_types_steps.py:94
    When an employee of type salaried is created with name="Over Emp" salary=50001 # features/steps/emp_types_steps.py:126
    Then the request is rejected with "exceeds budget"                             # features/steps/emp_types_steps.py:198

