@prefix :     <https://apilogicserver.github.io/ontology/demo_emp_types#> .
@prefix gl:   <https://apilogicserver.github.io/ontology/genai-logic#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Generated by ontology_gv.py. SHACL shapes for the constraints the engine enforces.
# 'translated' shapes state the condition in SHACL; 'descriptive' shapes carry the message only (the condition is code).
# The engine rejects a violating write; these shapes let any SHACL tool check data after the fact.

:shape_required_Department a sh:NodeShape ; sh:targetClass :Department ; sh:property [ sh:path :Department.name ; sh:minCount 1 ] ; sh:property [ sh:path :Department.budget ; sh:minCount 1 ] ; sh:message "Department: required columns are present" .
:shape_required_LaborUnion a sh:NodeShape ; sh:targetClass :LaborUnion ; sh:property [ sh:path :LaborUnion.name ; sh:minCount 1 ] ; sh:property [ sh:path :LaborUnion.dues_rate ; sh:minCount 1 ] ; sh:message "LaborUnion: required columns are present" .
:shape_required_SysConfig a sh:NodeShape ; sh:targetClass :SysConfig ; sh:property [ sh:path :SysConfig.name ; sh:minCount 1 ] ; sh:message "SysConfig: required columns are present" .
:shape_required_Employee a sh:NodeShape ; sh:targetClass :Employee ; sh:property [ sh:path :Employee.name ; sh:minCount 1 ] ; sh:property [ sh:path :Employee.dept ; sh:minCount 1 ] ; sh:property [ sh:path :Employee.type ; sh:minCount 1 ] ; sh:property [ sh:path :Employee.military ; sh:minCount 1 ] ; sh:message "Employee: required columns are present" .
:shape_required_Order a sh:NodeShape ; sh:targetClass :Order ; sh:property [ sh:path :Order.employee ; sh:minCount 1 ] ; sh:property [ sh:path :Order.customer_name ; sh:minCount 1 ] ; sh:property [ sh:path :Order.amount ; sh:minCount 1 ] ; sh:message "Order: required columns are present" .
:shape_rule_02 a sh:NodeShape ; sh:targetClass :Department ; sh:message "Department total_salary exceeds budget - only the manager role may exceed the budget" ; gl:origin "specified" ; rdfs:comment "descriptive" .
:shape_rule_07 a sh:NodeShape ; sh:targetClass :Employee ; sh:message "Employee type must be one of: salaried, hourly, commissioned" ; gl:origin "specified" ; sh:property [ sh:path :Employee.type ; sh:in ( "salaried" "hourly" "commissioned" ) ] ; rdfs:comment "translated" .
:shape_rule_08 a sh:NodeShape ; sh:targetClass :Employee ; sh:message "Hourly employee salary exceeds the weekly maximum (SysConfig.max_hourly_weekly_salary)" ; gl:origin "specified" ; rdfs:comment "descriptive" .
:shape_rule_09 a sh:NodeShape ; sh:targetClass :Employee ; sh:message "Only hourly employees may have a union_id" ; gl:origin "specified" ; sh:or ( [ sh:property [ sh:path :Employee.type ; sh:hasValue "hourly" ] ] [ sh:property [ sh:path :Employee.union ; sh:maxCount 0 ] ] ) ; rdfs:comment "translated" .
:shape_rule_10 a sh:NodeShape ; sh:targetClass :Employee ; sh:message "Only commissioned employees may have Orders" ; gl:origin "specified" ; sh:or ( [ sh:property [ sh:path :Employee.type ; sh:hasValue "commissioned" ] ] [ sh:property [ sh:path :Employee.order_count ; sh:hasValue 0 ] ] ) ; rdfs:comment "translated" .
:shape_rule_11 a sh:NodeShape ; sh:targetClass :Employee ; sh:message "hours_worked must be null for non-hourly employees" ; gl:origin "inferred" ; sh:or ( [ sh:property [ sh:path :Employee.type ; sh:hasValue "hourly" ] ] [ sh:property [ sh:path :Employee.hours_worked ; sh:maxCount 0 ] ] ) ; rdfs:comment "translated" .
:shape_rule_12 a sh:NodeShape ; sh:targetClass :Employee ; sh:message "hourly_rate must be null for non-hourly employees" ; gl:origin "inferred" ; sh:or ( [ sh:property [ sh:path :Employee.type ; sh:hasValue "hourly" ] ] [ sh:property [ sh:path :Employee.hourly_rate ; sh:maxCount 0 ] ] ) ; rdfs:comment "translated" .
:shape_rule_13 a sh:NodeShape ; sh:targetClass :Employee ; sh:message "base_salary must be null for non-commissioned employees" ; gl:origin "inferred" ; sh:or ( [ sh:property [ sh:path :Employee.type ; sh:hasValue "commissioned" ] ] [ sh:property [ sh:path :Employee.base_salary ; sh:maxCount 0 ] ] ) ; rdfs:comment "translated" .
:shape_rule_16 a sh:NodeShape ; sh:targetClass :Employee ; sh:message "military must be 'yes' or 'no'" ; gl:origin "inferred" ; sh:property [ sh:path :Employee.military ; sh:in ( "yes" "no" ) ] ; rdfs:comment "translated" .
:shape_rule_17 a sh:NodeShape ; sh:targetClass :Employee ; sh:message "branch must be one of: Army, Navy, Air Force, Marines, Coast Guard" ; gl:origin "specified" ; sh:property [ sh:path :Employee.branch ; sh:in ( "Army" "Navy" "Air Force" "Marines" "Coast Guard" ) ] ; rdfs:comment "translated" .
:shape_rule_18 a sh:NodeShape ; sh:targetClass :Employee ; sh:message "branch must be null for non-military employees" ; gl:origin "inferred" ; sh:or ( [ sh:property [ sh:path :Employee.military ; sh:hasValue "yes" ] ] [ sh:property [ sh:path :Employee.branch ; sh:maxCount 0 ] ] ) ; rdfs:comment "translated" .
:shape_rule_19 a sh:NodeShape ; sh:targetClass :Employee ; sh:message "rank must be null for non-military employees" ; gl:origin "inferred" ; sh:or ( [ sh:property [ sh:path :Employee.military ; sh:hasValue "yes" ] ] [ sh:property [ sh:path :Employee.rank ; sh:maxCount 0 ] ] ) ; rdfs:comment "translated" .
:shape_rule_20 a sh:NodeShape ; sh:targetClass :Employee ; sh:message "service_years must be null for non-military employees" ; gl:origin "inferred" ; sh:or ( [ sh:property [ sh:path :Employee.military ; sh:hasValue "yes" ] ] [ sh:property [ sh:path :Employee.service_years ; sh:maxCount 0 ] ] ) ; rdfs:comment "translated" .
