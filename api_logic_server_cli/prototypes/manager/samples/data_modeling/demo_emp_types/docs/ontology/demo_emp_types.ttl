# ---- Rules, as linked governance artifacts ----
:rule_01 a gl:Sum ;
    rdfs:label "Department.total_salary = sum(Employee.salary)" ;
    gl:useCase "department_budget" ;
    gl:sourceFile "logic/logic_discovery/department_budget.py" ;
    gl:origin "specified" ;
    gl:requirement "Department.total_salary = sum of Employee.salary (all types)." ;
    gl:expression "Rule.sum(derive=models.Department.total_salary, as_sum_of=models.Employee.salary)" ;
    gl:derives :Department.total_salary ;
    gl:dependsOn :Employee.salary .
:rule_02 a gl:Constraint ;
    rdfs:label "Department total_salary exceeds budget - only the manager role may exceed the budget" ;
    gl:useCase "department_budget" ;
    gl:sourceFile "logic/logic_discovery/department_budget.py" ;
    gl:origin "specified" ;
    gl:requirement "Department.total_salary must not exceed Department.budget." ;
    gl:expression "Rule.constraint(validate=models.Department, calling=_total_salary_within_budget, error_msg=\"Department total_salary ({row.total_salary}) exceeds budget ({row.budget}) - only the manager role may exceed the budget\")" ;
    gl:errorMessage "Department total_salary ({row.total_salary}) exceeds budget ({row.budget}) - only the manager role may exceed the budget" ;
    gl:validates :Department ;
    gl:shape :shape_rule_02 ;
    gl:dependsOn :Department.total_salary , :Department.budget .
:rule_03 a gl:Formula ;
    rdfs:label "Employee.salary derived by formula" ;
    gl:useCase "employee_pay" ;
    gl:sourceFile "logic/logic_discovery/employee_pay.py" ;
    gl:origin "specified" ;
    gl:requirement "Hourly employees: salary = hours_worked * hourly_rate. / Commissioned employees: salary = base_salary + commission_total." ;
    gl:expression "Rule.formula(derive=models.Employee.salary, calling=_employee_salary)" ;
    gl:derives :Employee.salary ;
    gl:dependsOn :Employee.type , :Employee.hours_worked , :Employee.hourly_rate , :Employee.base_salary , :Employee.commission_total .
:rule_04 a gl:Formula ;
    rdfs:label "Employee.union_dues derived by formula" ;
    gl:useCase "employee_pay" ;
    gl:sourceFile "logic/logic_discovery/employee_pay.py" ;
    gl:origin "specified" ;
    gl:requirement "Hourly employees: union_dues = hours_worked * union.dues_rate (0 if no union assigned)." ;
    gl:expression "Rule.formula(derive=models.Employee.union_dues, calling=_union_dues)" ;
    gl:derives :Employee.union_dues ;
    gl:dependsOn :Employee.type , :Employee.union , :Employee.hours_worked , :LaborUnion.dues_rate .
:rule_05 a gl:Sum ;
    rdfs:label "Employee.commission_total = sum(Order.amount)" ;
    gl:useCase "employee_pay" ;
    gl:sourceFile "logic/logic_discovery/employee_pay.py" ;
    gl:origin "specified" ;
    gl:requirement "Commissioned employees: commission_total = sum of Order.amount." ;
    gl:expression "Rule.sum(derive=models.Employee.commission_total, as_sum_of=models.Order.amount)" ;
    gl:derives :Employee.commission_total ;
    gl:dependsOn :Order.amount .
:rule_06 a gl:Count ;
    rdfs:label "Employee.order_count = count(Order)" ;
    gl:useCase "employee_pay" ;
    gl:sourceFile "logic/logic_discovery/employee_pay.py" ;
    gl:origin "inferred" ;
    gl:expression "Rule.count(derive=models.Employee.order_count, as_count_of=models.Order)" ;
    gl:derives :Employee.order_count ;
    gl:dependsOn :Order .
:rule_07 a gl:Constraint ;
    rdfs:label "Employee type must be one of: salaried, hourly, commissioned" ;
    gl:useCase "employee_pay" ;
    gl:sourceFile "logic/logic_discovery/employee_pay.py" ;
    gl:origin "specified" ;
    gl:requirement "Employees have a type that is one of: 'salaried', 'hourly', or 'commissioned'." ;
    gl:expression "Rule.constraint(validate=models.Employee, as_condition=lambda row: row.type in EMPLOYEE_TYPES, error_msg=\"Employee type ({row.type}) must be one of: salaried, hourly, commissioned\")" ;
    gl:errorMessage "Employee type ({row.type}) must be one of: salaried, hourly, commissioned" ;
    gl:validates :Employee ;
    gl:shape :shape_rule_07 ;
    gl:dependsOn :Employee.type .
:rule_08 a gl:Constraint ;
    rdfs:label "Hourly employee salary exceeds the weekly maximum (SysConfig.max_hourly_weekly_salary)" ;
    gl:useCase "employee_pay" ;
    gl:sourceFile "logic/logic_discovery/employee_pay.py" ;
    gl:origin "specified" ;
    gl:requirement "Hourly employees: salary must not exceed 5000 per week." ;
    gl:expression "Rule.constraint(validate=models.Employee, calling=_hourly_salary_within_weekly_cap, error_msg=\"Hourly employee salary ({row.salary}) exceeds the weekly maximum (SysConfig.max_hourly_weekly_salary)\")" ;
    gl:errorMessage "Hourly employee salary ({row.salary}) exceeds the weekly maximum (SysConfig.max_hourly_weekly_salary)" ;
    gl:validates :Employee ;
    gl:shape :shape_rule_08 ;
    gl:dependsOn :Employee.type , :Employee.salary , :SysConfig.max_hourly_weekly_salary .
:rule_09 a gl:Constraint ;
    rdfs:label "Only hourly employees may have a union_id" ;
    gl:useCase "employee_pay" ;
    gl:sourceFile "logic/logic_discovery/employee_pay.py" ;
    gl:origin "specified" ;
    gl:requirement "Hourly employees may be assigned to a Union (optional); only Hourly employees may have a union_id." ;
    gl:expression "Rule.constraint(validate=models.Employee, as_condition=lambda row: row.type == 'hourly' or row.union_id is None, error_msg=\"Only hourly employees may have a union_id\")" ;
    gl:errorMessage "Only hourly employees may have a union_id" ;
    gl:validates :Employee ;
    gl:shape :shape_rule_09 ;
    gl:appliesToType :HourlyEmployee ;
    gl:dependsOn :Employee.type , :Employee.union .
:rule_10 a gl:Constraint ;
    rdfs:label "Only commissioned employees may have Orders" ;
    gl:useCase "employee_pay" ;
    gl:sourceFile "logic/logic_discovery/employee_pay.py" ;
    gl:origin "specified" ;
    gl:requirement "Commissioned employees are employees who can have Orders; only Commissioned employees may have Orders." ;
    gl:expression "Rule.constraint(validate=models.Employee, as_condition=lambda row: row.type == 'commissioned' or row.order_count == 0, error_msg=\"Only commissioned employees may have Orders (order_count is {row.order_count})\")" ;
    gl:errorMessage "Only commissioned employees may have Orders (order_count is {row.order_count})" ;
    gl:validates :Employee ;
    gl:shape :shape_rule_10 ;
    gl:appliesToType :CommissionedEmployee ;
    gl:dependsOn :Employee.type , :Employee.order_count .
:rule_11 a gl:Constraint ;
    rdfs:label "hours_worked must be null for non-hourly employees" ;
    gl:useCase "employee_pay" ;
    gl:sourceFile "logic/logic_discovery/employee_pay.py" ;
    gl:origin "inferred" ;
    gl:expression "Rule.constraint(validate=models.Employee, as_condition=lambda row: row.type == 'hourly' or row.hours_worked is None, error_msg=\"hours_worked must be null for non-hourly employees\")" ;
    gl:errorMessage "hours_worked must be null for non-hourly employees" ;
    gl:validates :Employee ;
    gl:shape :shape_rule_11 ;
    gl:appliesToType :HourlyEmployee ;
    gl:dependsOn :Employee.type , :Employee.hours_worked .
:rule_12 a gl:Constraint ;
    rdfs:label "hourly_rate must be null for non-hourly employees" ;
    gl:useCase "employee_pay" ;
    gl:sourceFile "logic/logic_discovery/employee_pay.py" ;
    gl:origin "inferred" ;
    gl:expression "Rule.constraint(validate=models.Employee, as_condition=lambda row: row.type == 'hourly' or row.hourly_rate is None, error_msg=\"hourly_rate must be null for non-hourly employees\")" ;
    gl:errorMessage "hourly_rate must be null for non-hourly employees" ;
    gl:validates :Employee ;
    gl:shape :shape_rule_12 ;
    gl:appliesToType :HourlyEmployee ;
    gl:dependsOn :Employee.type , :Employee.hourly_rate .
:rule_13 a gl:Constraint ;
    rdfs:label "base_salary must be null for non-commissioned employees" ;
    gl:useCase "employee_pay" ;
    gl:sourceFile "logic/logic_discovery/employee_pay.py" ;
    gl:origin "inferred" ;
    gl:expression "Rule.constraint(validate=models.Employee, as_condition=lambda row: row.type == 'commissioned' or row.base_salary is None, error_msg=\"base_salary must be null for non-commissioned employees\")" ;
    gl:errorMessage "base_salary must be null for non-commissioned employees" ;
    gl:validates :Employee ;
    gl:shape :shape_rule_13 ;
    gl:appliesToType :CommissionedEmployee ;
    gl:dependsOn :Employee.type , :Employee.base_salary .
:rule_14 a gl:Formula ;
    rdfs:label "Employee.military_stipend derived by formula" ;
    gl:useCase "military_compensation" ;
    gl:sourceFile "logic/logic_discovery/military_compensation.py" ;
    gl:origin "specified" ;
    gl:requirement "Military employees receive a military_stipend (REAL) = service_years * 100. / Total compensation for military employees = salary + military_stipend." ;
    gl:expression "Rule.formula(derive=models.Employee.military_stipend, calling=_military_stipend)" ;
    gl:derives :Employee.military_stipend ;
    gl:dependsOn :Employee.military , :Employee.service_years , :SysConfig.military_stipend_per_service_year .
:rule_15 a gl:Formula ;
    rdfs:label "Employee.total_compensation derived by formula" ;
    gl:useCase "military_compensation" ;
    gl:sourceFile "logic/logic_discovery/military_compensation.py" ;
    gl:origin "specified" ;
    gl:requirement "Total compensation for military employees = salary + military_stipend." ;
    gl:expression "Rule.formula(derive=models.Employee.total_compensation, calling=_total_compensation)" ;
    gl:derives :Employee.total_compensation ;
    gl:dependsOn :Employee.military , :Employee.salary , :Employee.military_stipend .
:rule_16 a gl:Constraint ;
    rdfs:label "military must be 'yes' or 'no'" ;
    gl:useCase "military_compensation" ;
    gl:sourceFile "logic/logic_discovery/military_compensation.py" ;
    gl:origin "inferred" ;
    gl:expression "Rule.constraint(validate=models.Employee, as_condition=lambda row: row.military in MILITARY_VALUES, error_msg=\"military ({row.military}) must be 'yes' or 'no'\")" ;
    gl:errorMessage "military ({row.military}) must be 'yes' or 'no'" ;
    gl:validates :Employee ;
    gl:shape :shape_rule_16 ;
    gl:dependsOn :Employee.military .
:rule_17 a gl:Constraint ;
    rdfs:label "branch must be one of: Army, Navy, Air Force, Marines, Coast Guard" ;
    gl:useCase "military_compensation" ;
    gl:sourceFile "logic/logic_discovery/military_compensation.py" ;
    gl:origin "specified" ;
    gl:requirement "Military employees have a branch (TEXT: 'Army', 'Navy', 'Air Force', 'Marines', 'Coast Guard')," ;
    gl:expression "Rule.constraint(validate=models.Employee, as_condition=lambda row: row.branch is None or row.branch in MILITARY_BRANCHES, error_msg=\"branch ({row.branch}) must be one of: Army, Navy, Air Force, Marines, Coast Guard\")" ;
    gl:errorMessage "branch ({row.branch}) must be one of: Army, Navy, Air Force, Marines, Coast Guard" ;
    gl:validates :Employee ;
    gl:shape :shape_rule_17 ;
    gl:dependsOn :Employee.branch .
:rule_18 a gl:Constraint ;
    rdfs:label "branch must be null for non-military employees" ;
    gl:useCase "military_compensation" ;
    gl:sourceFile "logic/logic_discovery/military_compensation.py" ;
    gl:origin "inferred" ;
    gl:expression "Rule.constraint(validate=models.Employee, as_condition=lambda row: row.military == 'yes' or row.branch is None, error_msg=\"branch must be null for non-military employees\")" ;
    gl:errorMessage "branch must be null for non-military employees" ;
    gl:validates :Employee ;
    gl:shape :shape_rule_18 ;
    gl:appliesToType :MilitaryEmployee ;
    gl:dependsOn :Employee.military , :Employee.branch .
:rule_19 a gl:Constraint ;
    rdfs:label "rank must be null for non-military employees" ;
    gl:useCase "military_compensation" ;
    gl:sourceFile "logic/logic_discovery/military_compensation.py" ;
    gl:origin "inferred" ;
    gl:expression "Rule.constraint(validate=models.Employee, as_condition=lambda row: row.military == 'yes' or row.rank is None, error_msg=\"rank must be null for non-military employees\")" ;
    gl:errorMessage "rank must be null for non-military employees" ;
    gl:validates :Employee ;
    gl:shape :shape_rule_19 ;
    gl:appliesToType :MilitaryEmployee ;
    gl:dependsOn :Employee.military , :Employee.rank .
:rule_20 a gl:Constraint ;
    rdfs:label "service_years must be null for non-military employees" ;
    gl:useCase "military_compensation" ;
    gl:sourceFile "logic/logic_discovery/military_compensation.py" ;
    gl:origin "inferred" ;
    gl:expression "Rule.constraint(validate=models.Employee, as_condition=lambda row: row.military == 'yes' or row.service_years is None, error_msg=\"service_years must be null for non-military employees\")" ;
    gl:errorMessage "service_years must be null for non-military employees" ;
    gl:validates :Employee ;
    gl:shape :shape_rule_20 ;
    gl:appliesToType :MilitaryEmployee ;
    gl:dependsOn :Employee.military , :Employee.service_years .
