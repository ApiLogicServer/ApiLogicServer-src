:Employee a owl:Class ; rdfs:label "Employee" ; rdfs:comment "table employee" .
:Order a owl:Class ; rdfs:label "Order" ; rdfs:comment "table order" .

# ---- Subtypes (single-table inheritance): defined classes, membership inferred from the discriminator ----
:SalariedEmployee a owl:Class ; rdfs:label "SalariedEmployee" ; rdfs:subClassOf :Employee ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Employee [ a owl:Restriction ; owl:onProperty :Employee.type ; owl:hasValue "salaried" ] ) ] .
:HourlyEmployee a owl:Class ; rdfs:label "HourlyEmployee" ; rdfs:subClassOf :Employee ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Employee [ a owl:Restriction ; owl:onProperty :Employee.type ; owl:hasValue "hourly" ] ) ] .
:CommissionedEmployee a owl:Class ; rdfs:label "CommissionedEmployee" ; rdfs:subClassOf :Employee ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Employee [ a owl:Restriction ; owl:onProperty :Employee.type ; owl:hasValue "commissioned" ] ) ] .
:MilitaryEmployee a owl:Class ; rdfs:label "MilitaryEmployee" ; rdfs:subClassOf :Employee ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Employee [ a owl:Restriction ; owl:onProperty :Employee.military ; owl:hasValue "yes" ] ) ] .
[] a owl:AllDisjointClasses ; owl:members ( :SalariedEmployee :HourlyEmployee :CommissionedEmployee ) .

