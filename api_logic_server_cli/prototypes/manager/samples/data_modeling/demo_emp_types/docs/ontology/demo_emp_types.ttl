# ---- Rules, as linked governance artifacts ----
:rule_01 a gl:Sum ;
    rdfs:label "Employee.commission_total = sum(Order.amount)" ;
    gl:useCase "commissioned_employees" ;
    gl:sourceFile "logic/logic_discovery/commissioned_employees.py" ;
    gl:origin "specified" ;
    gl:requirement "Commissioned employees are employees who can have Orders; only Commissioned employees may have Orders. Each Order has an amount and a customer name. Commissioned employees: commission_total = sum of Order.amount." ;
    gl:expression "Rule.sum(derive=models.Employee.commission_total, as_sum_of=models.Order.amount)" ;
    gl:derives :Employee.commission_total ;
    gl:dependsOn :Order.amount .
:rule_02 a gl:Count ;
    rdfs:label "Employee.order_count = count(Order)" ;
    gl:useCase "commissioned_employees" ;
    gl:sourceFile "logic/logic_discovery/commissioned_employees.py" ;
    gl:origin "inferred" ;
    gl:expression "Rule.count(derive=models.Employee.order_count, as_count_of=models.Order)" ;
    gl:derives :Employee.order_count ;
    gl:dependsOn :Order .
:rule_03 a gl:Constraint ;
    rdfs:label "Only commissioned employees may have Orders" ;
    gl:useCase "commissioned_employees" ;
    gl:sourceFile "logic/logic_discovery/commissioned_employees.py" ;
    gl:origin "specified" ;
    gl:requirement "Commissioned employees are employees who can have Orders; only Commissioned employees may have Orders. Each Order has an amount and a customer name. Commissioned employees: commission_total = sum of Order.amount." ;
    gl:expression "Rule.constraint(validate=models.Employee, as_condition=lambda row: row.type == 'commissioned' or row.order_count == 0, error_msg=\"Only commissioned employees may have Orders\")" ;
    gl:errorMessage "Only commissioned employees may have Orders" ;
    gl:validates :Employee ;
    gl:shape :shape_rule_03 ;
    gl:appliesToType :CommissionedEmployee ;
    gl:dependsOn :Employee.type , :Employee.order_count .
:rule_04 a gl:Constraint ;
    rdfs:label "base_salary applies only to commissioned employees" ;
    gl:useCase "commissioned_employees" ;
    gl:sourceFile "logic/logic_discovery/commissioned_employees.py" ;
    gl:origin "specified" ;
    gl:requirement "Commissioned employees are employees who can have Orders; only Commissioned employees may have Orders. Each Order has an amount and a customer name. Commissioned employees: commission_total = sum of Order.amount." ;
    gl:expression "Rule.constraint(validate=models.Employee, as_condition=lambda row: row.type == 'commissioned' or row.base_salary is None, error_msg=\"base_salary applies only to commissioned employees\")" ;
    gl:errorMessage "base_salary applies only to commissioned employees" ;
    gl:validates :Employee ;
    gl:shape :shape_rule_04 ;
    gl:appliesToType :CommissionedEmployee ;
    gl:dependsOn :Employee.type , :Employee.base_salary .
:rule_05 a gl:Sum ;
    rdfs:label "Department.total_salary = sum(Employee.salary)" ;
    gl:useCase "department_budget" ;
    gl:sourceFile "logic/logic_discovery/department_budget.py" ;
    gl:origin "specified" ;
    gl:requirement "Departments have a name and a budget. Department.total_salary = sum of Employee.salary (all types). Department.total_salary must not exceed Department.budget. A user with the manager role may exceed the budget; other users may not." ;
    gl:expression "Rule.sum(derive=models.Department.total_salary, as_sum_of=models.Employee.salary)" ;
    gl:derives :Department.total_salary ;
    gl:dependsOn :Employee.salary .
:rule_06 a gl:Constraint ;
    rdfs:label "Department total_salary exceeds budget" ;
    gl:useCase "department_budget" ;
    gl:sourceFile "logic/logic_discovery/department_budget.py" ;
    gl:origin "specified" ;
    gl:requirement "Departments have a name and a budget. Department.total_salary = sum of Employee.salary (all types). Department.total_salary must not exceed Department.budget. A user with the manager role may exceed the budget; other users may not." ;
    gl:expression "Rule.constraint(validate=models.Department, calling=_total_salary_within_budget, error_msg=\"Department total_salary ({row.total_salary}) exceeds budget ({row.budget})\")" ;
    gl:errorMessage "Department total_salary ({row.total_salary}) exceeds budget ({row.budget})" ;
    gl:validates :Department ;
    gl:shape :shape_rule_06 ;
    gl:dependsOn :Department.total_salary , :Department.budget .
:rule_07 a gl:Formula ;
    rdfs:label "Employee.salary derived by formula" ;
    gl:useCase "employee_types" ;
    gl:sourceFile "logic/logic_discovery/employee_types.py" ;
    gl:origin "specified" ;
    gl:requirement "Hourly employees: salary = hours_worked * hourly_rate. / Commissioned employees: salary = base_salary + commission_total." ;
    gl:expression "Rule.formula(derive=models.Employee.salary, calling=_salary)" ;
    gl:derives :Employee.salary ;
    gl:dependsOn :Employee.type , :Employee.hours_worked , :Employee.hourly_rate , :Employee.base_salary , :Employee.commission_total .
:rule_08 a gl:Constraint ;
    rdfs:label "Employee type must be salaried, hourly or commissioned" ;
    gl:useCase "employee_types" ;
    gl:sourceFile "logic/logic_discovery/employee_types.py" ;
    gl:origin "specified" ;
    gl:requirement "Employees have a name, dept, and salary. Employees have a type that is one of: 'salaried', 'hourly', or 'commissioned'." ;
    gl:expression "Rule.constraint(validate=models.Employee, as_condition=lambda row: row.type in ('salaried', 'hourly', 'commissioned'), error_msg=\"Employee type ({row.type}) must be salaried, hourly or commissioned\")" ;
    gl:errorMessage "Employee type ({row.type}) must be salaried, hourly or commissioned" ;
    gl:validates :Employee ;
    gl:shape :shape_rule_08 ;
    gl:dependsOn :Employee.type .
:rule_09 a gl:Formula ;
    rdfs:label "Employee.union_dues derived by formula" ;
    gl:useCase "hourly_employees" ;
    gl:sourceFile "logic/logic_discovery/hourly_employees.py" ;
    gl:origin "specified" ;
    gl:requirement "Hourly employees are employees with hours_worked (REAL) and hourly_rate (REAL). Hourly employees: salary must not exceed 5000 per week. Hourly employees may be assigned to a Union (optional); only Hourly employees may have a union_id. Unions have a name and a dues_rate (REAL). Hourly employees: union_dues = hours_worked * union.dues_rate (0 if no union assigned)." ;
    gl:expression "Rule.formula(derive=models.Employee.union_dues, calling=_union_dues)" ;
    gl:derives :Employee.union_dues ;
    gl:dependsOn :Employee.type , :Employee.hours_worked , :LaborUnion.dues_rate .
:rule_10 a gl:Constraint ;
    rdfs:label "Hourly salary exceeds the weekly maximum" ;
    gl:useCase "hourly_employees" ;
    gl:sourceFile "logic/logic_discovery/hourly_employees.py" ;
    gl:origin "specified" ;
    gl:requirement "Hourly employees are employees with hours_worked (REAL) and hourly_rate (REAL). Hourly employees: salary must not exceed 5000 per week. Hourly employees may be assigned to a Union (optional); only Hourly employees may have a union_id. Unions have a name and a dues_rate (REAL). Hourly employees: union_dues = hours_worked * union.dues_rate (0 if no union assigned)." ;
    gl:expression "Rule.constraint(validate=models.Employee, calling=_hourly_salary_within_cap, error_msg=\"Hourly salary ({row.salary}) exceeds the weekly maximum\")" ;
    gl:errorMessage "Hourly salary ({row.salary}) exceeds the weekly maximum" ;
    gl:validates :Employee ;
    gl:shape :shape_rule_10 ;
    gl:dependsOn :Employee.type , :Employee.salary , :SysConfig.max_hourly_weekly_salary .
:rule_11 a gl:Constraint ;
    rdfs:label "Only hourly employees may have a union_id" ;
    gl:useCase "hourly_employees" ;
    gl:sourceFile "logic/logic_discovery/hourly_employees.py" ;
    gl:origin "specified" ;
    gl:requirement "Hourly employees are employees with hours_worked (REAL) and hourly_rate (REAL). Hourly employees: salary must not exceed 5000 per week. Hourly employees may be assigned to a Union (optional); only Hourly employees may have a union_id. Unions have a name and a dues_rate (REAL). Hourly employees: union_dues = hours_worked * union.dues_rate (0 if no union assigned)." ;
    gl:expression "Rule.constraint(validate=models.Employee, as_condition=lambda row: row.type == 'hourly' or row.union_id is None, error_msg=\"Only hourly employees may have a union_id\")" ;
    gl:errorMessage "Only hourly employees may have a union_id" ;
    gl:validates :Employee ;
    gl:shape :shape_rule_11 ;
    gl:appliesToType :HourlyEmployee ;
    gl:dependsOn :Employee.type , :Employee.union .
:rule_12 a gl:Constraint ;
    rdfs:label "hours_worked and hourly_rate apply only to hourly employees" ;
    gl:useCase "hourly_employees" ;
    gl:sourceFile "logic/logic_discovery/hourly_employees.py" ;
    gl:origin "specified" ;
    gl:requirement "Hourly employees are employees with hours_worked (REAL) and hourly_rate (REAL). Hourly employees: salary must not exceed 5000 per week. Hourly employees may be assigned to a Union (optional); only Hourly employees may have a union_id. Unions have a name and a dues_rate (REAL). Hourly employees: union_dues = hours_worked * union.dues_rate (0 if no union assigned)." ;
    gl:expression "Rule.constraint(validate=models.Employee, as_condition=lambda row: row.type == 'hourly' or (row.hours_worked is None and row.hourly_rate is None), error_msg=\"hours_worked and hourly_rate apply only to hourly employees\")" ;
    gl:errorMessage "hours_worked and hourly_rate apply only to hourly employees" ;
    gl:validates :Employee ;
    gl:shape :shape_rule_12 ;
    gl:appliesToType :HourlyEmployee ;
    gl:dependsOn :Employee.type , :Employee.hours_worked , :Employee.hourly_rate .
:rule_13 a gl:Formula ;
    rdfs:label "Employee.military_stipend derived by formula" ;
    gl:useCase "military_employees" ;
    gl:sourceFile "logic/logic_discovery/military_employees.py" ;
    gl:origin "specified" ;
    gl:requirement "Employees may also have a military classification, independent of employment type. Military employees have a branch (TEXT: 'Army', 'Navy', 'Air Force', 'Marines', 'Coast Guard'), a rank (TEXT), and service_years (INTEGER). Military employees receive a military_stipend (REAL) = service_years * 100. Total compensation for military employees = salary + military_stipend. Total compensation for non-military employees = salary." ;
    gl:expression "Rule.formula(derive=models.Employee.military_stipend, calling=_military_stipend)" ;
    gl:derives :Employee.military_stipend ;
    gl:dependsOn :Employee.military , :Employee.service_years , :SysConfig.military_stipend_per_year .
:rule_14 a gl:Formula ;
    rdfs:label "Employee.total_compensation derived by formula" ;
    gl:useCase "military_employees" ;
    gl:sourceFile "logic/logic_discovery/military_employees.py" ;
    gl:origin "specified" ;
    gl:requirement "Employees may also have a military classification, independent of employment type. Military employees have a branch (TEXT: 'Army', 'Navy', 'Air Force', 'Marines', 'Coast Guard'), a rank (TEXT), and service_years (INTEGER). Military employees receive a military_stipend (REAL) = service_years * 100. Total compensation for military employees = salary + military_stipend. Total compensation for non-military employees = salary." ;
    gl:expression "Rule.formula(derive=models.Employee.total_compensation, as_expression=lambda row: row.salary + row.military_stipend if row.military == \"yes\" else row.salary)" ;
    gl:derives :Employee.total_compensation ;
    gl:appliesToType :MilitaryEmployee ;
    gl:dependsOn :Employee.salary , :Employee.military , :Employee.military_stipend .
:rule_15 a gl:Constraint ;
    rdfs:label "military must be yes or no" ;
    gl:useCase "military_employees" ;
    gl:sourceFile "logic/logic_discovery/military_employees.py" ;
    gl:origin "specified" ;
    gl:requirement "Employees may also have a military classification, independent of employment type. Military employees have a branch (TEXT: 'Army', 'Navy', 'Air Force', 'Marines', 'Coast Guard'), a rank (TEXT), and service_years (INTEGER). Military employees receive a military_stipend (REAL) = service_years * 100. Total compensation for military employees = salary + military_stipend. Total compensation for non-military employees = salary." ;
    gl:expression "Rule.constraint(validate=models.Employee, calling=_military_valid, error_msg=\"military must be yes or no\")" ;
    gl:errorMessage "military must be yes or no" ;
    gl:validates :Employee ;
    gl:shape :shape_rule_15 ;
    gl:dependsOn :Employee.military .
:rule_16 a gl:Constraint ;
    rdfs:label "branch must be Army, Navy, Air Force, Marines or Coast Guard" ;
    gl:useCase "military_employees" ;
    gl:sourceFile "logic/logic_discovery/military_employees.py" ;
    gl:origin "specified" ;
    gl:requirement "Employees may also have a military classification, independent of employment type. Military employees have a branch (TEXT: 'Army', 'Navy', 'Air Force', 'Marines', 'Coast Guard'), a rank (TEXT), and service_years (INTEGER). Military employees receive a military_stipend (REAL) = service_years * 100. Total compensation for military employees = salary + military_stipend. Total compensation for non-military employees = salary." ;
    gl:expression "Rule.constraint(validate=models.Employee, as_condition=lambda row: row.branch is None or row.branch in BRANCHES, error_msg=\"branch ({row.branch}) must be Army, Navy, Air Force, Marines or Coast Guard\")" ;
    gl:errorMessage "branch ({row.branch}) must be Army, Navy, Air Force, Marines or Coast Guard" ;
    gl:validates :Employee ;
    gl:shape :shape_rule_16 ;
    gl:dependsOn :Employee.branch .
:rule_17 a gl:Constraint ;
    rdfs:label "branch, rank and service_years apply only to military employees" ;
    gl:useCase "military_employees" ;
    gl:sourceFile "logic/logic_discovery/military_employees.py" ;
    gl:origin "specified" ;
    gl:requirement "Employees may also have a military classification, independent of employment type. Military employees have a branch (TEXT: 'Army', 'Navy', 'Air Force', 'Marines', 'Coast Guard'), a rank (TEXT), and service_years (INTEGER). Military employees receive a military_stipend (REAL) = service_years * 100. Total compensation for military employees = salary + military_stipend. Total compensation for non-military employees = salary." ;
    gl:expression "Rule.constraint(validate=models.Employee, as_condition=lambda row: row.military == \"yes\" or (row.branch is None and row.rank is None and row.service_years is None), error_msg=\"branch, rank and service_years apply only to military employees\")" ;
    gl:errorMessage "branch, rank and service_years apply only to military employees" ;
    gl:validates :Employee ;
    gl:shape :shape_rule_17 ;
    gl:appliesToType :MilitaryEmployee ;
    gl:dependsOn :Employee.military , :Employee.branch , :Employee.rank , :Employee.service_years .
