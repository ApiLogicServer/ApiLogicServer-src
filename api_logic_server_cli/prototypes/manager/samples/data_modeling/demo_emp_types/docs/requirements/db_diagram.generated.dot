digraph db {
  graph [rankdir=TB, bgcolor="#fbfbfb", pad=0.3, nodesep=0.6, ranksep=0.9, fontname="Helvetica"];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [color="#9b9ca4", penwidth=1.2, dir=both, arrowtail=tee, arrowhead=crow, arrowsize=0.8];
  "Department" [label=<<TABLE BORDER="1" COLOR="#d9d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#f2f2f2"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#3f6792"><FONT COLOR="white" POINT-SIZE="12"><B>Department</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> <FONT POINT-SIZE="8" COLOR="#3f6792">PK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">name&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT">budget&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>total_salary</I> <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,2)</FONT></TD></TR></TABLE>>];
  "Employee" [label=<<TABLE BORDER="1" COLOR="#d9d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#f2f2f2"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#3f6792"><FONT COLOR="white" POINT-SIZE="12"><B>Employee</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> <FONT POINT-SIZE="8" COLOR="#3f6792">PK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">Type&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT">name&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT">dept_id <FONT POINT-SIZE="8" COLOR="#3f6792">FK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>salary</I> <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>commission_total</I> <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,2)</FONT></TD></TR><TR><TD ALIGN="LEFT">military&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>total_compensation</I> <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,2)</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#fdf3e0"><FONT POINT-SIZE="9" COLOR="#7a5c00"><B>hourly</B>  (Type = hourly)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf3e0">hours_worked <FONT POINT-SIZE="8" COLOR="#7a5c00"><I>hourly</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#fdf3e0"><FONT POINT-SIZE="9" COLOR="#777777">FLOAT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf3e0">hourly_rate <FONT POINT-SIZE="8" COLOR="#7a5c00"><I>hourly</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#fdf3e0"><FONT POINT-SIZE="9" COLOR="#777777">FLOAT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf3e0">union_id <FONT POINT-SIZE="8" COLOR="#3f6792">FK</FONT> <FONT POINT-SIZE="8" COLOR="#7a5c00"><I>hourly</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#fdf3e0"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf3e0"><I>union_dues</I> <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT> <FONT POINT-SIZE="8" COLOR="#7a5c00"><I>hourly</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#fdf3e0"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,2)</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#e6f3ea"><FONT POINT-SIZE="9" COLOR="#7a5c00"><B>commissioned</B>  (Type = commissioned)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6f3ea">base_salary <FONT POINT-SIZE="8" COLOR="#7a5c00"><I>commissioned</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#e6f3ea"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e6f3ea"><I>order_count</I> <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT> <FONT POINT-SIZE="8" COLOR="#7a5c00"><I>commissioned</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#e6f3ea"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#f0e6f5"><FONT POINT-SIZE="9" COLOR="#7a5c00"><B>military</B>  (military = yes)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f0e6f5">branch <FONT POINT-SIZE="8" COLOR="#7a5c00"><I>military</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#f0e6f5"><FONT POINT-SIZE="9" COLOR="#777777">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f0e6f5">rank <FONT POINT-SIZE="8" COLOR="#7a5c00"><I>military</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#f0e6f5"><FONT POINT-SIZE="9" COLOR="#777777">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f0e6f5">service_years <FONT POINT-SIZE="8" COLOR="#7a5c00"><I>military</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#f0e6f5"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f0e6f5"><I>military_stipend</I> <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT> <FONT POINT-SIZE="8" COLOR="#7a5c00"><I>military</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#f0e6f5"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,2)</FONT></TD></TR></TABLE>>];
  "LaborUnion" [label=<<TABLE BORDER="1" COLOR="#d9d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#f2f2f2"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#3f6792"><FONT COLOR="white" POINT-SIZE="12"><B>LaborUnion</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> <FONT POINT-SIZE="8" COLOR="#3f6792">PK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">name&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT">dues_rate&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">FLOAT</FONT></TD></TR></TABLE>>];
  "Order" [label=<<TABLE BORDER="1" COLOR="#d9d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#f2f2f2"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#3f6792"><FONT COLOR="white" POINT-SIZE="12"><B>Order</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> <FONT POINT-SIZE="8" COLOR="#3f6792">PK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">employee_id <FONT POINT-SIZE="8" COLOR="#3f6792">FK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">amount&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,2)</FONT></TD></TR><TR><TD ALIGN="LEFT">customer_name&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">TEXT</FONT></TD></TR></TABLE>>];
  "SysConfig" [label=<<TABLE BORDER="1" COLOR="#d9d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#f2f2f2"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#3f6792"><FONT COLOR="white" POINT-SIZE="12"><B>SysConfig</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> <FONT POINT-SIZE="8" COLOR="#3f6792">PK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">name&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT">discount_rate&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">FLOAT</FONT></TD></TR><TR><TD ALIGN="LEFT">tax_rate&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">FLOAT</FONT></TD></TR><TR><TD ALIGN="LEFT">notes&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT">max_hourly_weekly_salary&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,2)</FONT></TD></TR><TR><TD ALIGN="LEFT">military_stipend_per_year&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,2)</FONT></TD></TR></TABLE>>];
  "Department" -> "Employee";
  "LaborUnion" -> "Employee";
  "Employee" -> "Order";
  { rank=min; "Department"; "LaborUnion"; "SysConfig"; }
}