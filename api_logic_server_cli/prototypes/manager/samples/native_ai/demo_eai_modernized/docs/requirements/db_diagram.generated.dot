digraph db {
  graph [rankdir=TB, bgcolor="#fbfbfb", pad=0.3, nodesep=0.6, ranksep=0.9, fontname="Helvetica"];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [color="#9b9ca4", penwidth=1.2, dir=both, arrowtail=tee, arrowhead=crow, arrowsize=0.8];
  "Customer" [label=<<TABLE BORDER="1" COLOR="#d9d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#f2f2f2"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#3f6792"><FONT COLOR="white" POINT-SIZE="12"><B>Customer</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> <FONT POINT-SIZE="8" COLOR="#3f6792">PK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">name&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbe6f3">balance <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#dbe6f3"><FONT POINT-SIZE="9" COLOR="#777777">DECIMAL</FONT></TD></TR><TR><TD ALIGN="LEFT">credit_limit&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">DECIMAL</FONT></TD></TR><TR><TD ALIGN="LEFT">email&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">email_opt_out&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">BOOLEAN</FONT></TD></TR></TABLE>>];
  "Item" [label=<<TABLE BORDER="1" COLOR="#d9d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#f2f2f2"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#3f6792"><FONT COLOR="white" POINT-SIZE="12"><B>Item</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> <FONT POINT-SIZE="8" COLOR="#3f6792">PK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">order_id <FONT POINT-SIZE="8" COLOR="#3f6792">FK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">product_id <FONT POINT-SIZE="8" COLOR="#3f6792">FK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">quantity&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbe6f3">amount <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#dbe6f3"><FONT POINT-SIZE="9" COLOR="#777777">DECIMAL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbe6f3">unit_price <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#dbe6f3"><FONT POINT-SIZE="9" COLOR="#777777">DECIMAL</FONT></TD></TR></TABLE>>];
  "Order" [label=<<TABLE BORDER="1" COLOR="#d9d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#f2f2f2"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#3f6792"><FONT COLOR="white" POINT-SIZE="12"><B>Order</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> <FONT POINT-SIZE="8" COLOR="#3f6792">PK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">notes&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">customer_id <FONT POINT-SIZE="8" COLOR="#3f6792">FK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">CreatedOn&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT">date_shipped&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbe6f3">amount_total <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#dbe6f3"><FONT POINT-SIZE="9" COLOR="#777777">DECIMAL</FONT></TD></TR></TABLE>>];
  "Product" [label=<<TABLE BORDER="1" COLOR="#d9d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#f2f2f2"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#3f6792"><FONT COLOR="white" POINT-SIZE="12"><B>Product</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> <FONT POINT-SIZE="8" COLOR="#3f6792">PK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">name&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">count_suppliers&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">unit_price&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">DECIMAL</FONT></TD></TR></TABLE>>];
  "OrderB2bMessage" [label=<<TABLE BORDER="1" COLOR="#d9d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#f2f2f2"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#3f6792"><FONT COLOR="white" POINT-SIZE="12"><B>OrderB2bMessage</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> <FONT POINT-SIZE="8" COLOR="#3f6792">PK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">received_at&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT">payload&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT">is_processed&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT">error_text&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">TEXT</FONT></TD></TR></TABLE>>];
  "ProductSupplier" [label=<<TABLE BORDER="1" COLOR="#d9d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#f2f2f2"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#3f6792"><FONT COLOR="white" POINT-SIZE="12"><B>ProductSupplier</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> <FONT POINT-SIZE="8" COLOR="#3f6792">PK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">product_id <FONT POINT-SIZE="8" COLOR="#3f6792">FK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">supplier_id <FONT POINT-SIZE="8" COLOR="#3f6792">FK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">supplier_part_number&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">unit_cost&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">DECIMAL</FONT></TD></TR><TR><TD ALIGN="LEFT">lead_time_days&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR></TABLE>>];
  "Supplier" [label=<<TABLE BORDER="1" COLOR="#d9d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#f2f2f2"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#3f6792"><FONT COLOR="white" POINT-SIZE="12"><B>Supplier</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> <FONT POINT-SIZE="8" COLOR="#3f6792">PK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">name&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">contact_name&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">phone&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">email&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">region&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR</FONT></TD></TR></TABLE>>];
  "Order" -> "Item";
  "Product" -> "Item";
  "Customer" -> "Order";
  "Product" -> "ProductSupplier";
  "Supplier" -> "ProductSupplier";
  { rank=min; "Customer"; "Product"; "OrderB2bMessage"; "Supplier"; }
}