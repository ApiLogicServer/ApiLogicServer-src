# default.env - DEV defaults, committed with the project.  Non-secret values only: never put a real password here.
#   Pre-prod and prod do not use other files in this folder: their settings come from environment variables
#   (which override this file), and their secrets from a secrets store.  See config/readme-config.md.

# APILOGICPROJECT_ENV - dev | preprod | prod.  The deployment sets it (an env variable overrides this file);
#   the project's devops/docker-image dockerfile defaults it to prod.  Outside dev, the server will not start
#   with security enabled (SQL provider) and the placeholder SECRET_KEY below.
APILOGICPROJECT_ENV = dev

# SECRET_KEY - signs login tokens (SQL security provider).  This value is a placeholder for dev:
#   in pre-prod and prod, set SECRET_KEY from your secrets store; never commit a real one.
SECRET_KEY = "whatnothow"
SQLALCHEMY_TRACK_MODIFICATIONS = False
SQLAlCHEMY_ECHO = False
# AGGREGATE_DEFAULTS =  True
# ALL_DEFAULTS = True
# APILOGICPROJECT_KAFKA_PRODUCER = "{\"bootstrap.servers\": \"localhost:9092\"}"
# SQLALCHEMY_DATABASE_URI=db.sqlite

# required if you are not running from venv or docker apilogicserver/api_logic_server (eg, azure)
# APILOGICPROJECT_APILOGICSERVERHOME=src/ApiLogicServer-src

SECURITY_ENABLED = false

# if using tunnel for mcp, function, or ai_plugin
# eg, https://tunnel_url.ngrok-free.app
API_LOGIC_SERVER_TUNNEL = "TUNNEL_URL"