<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ result.title }}</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <style>
        html, body { margin: 0; padding: 0; height: 100%; box-sizing: border-box; font-family: sans-serif; }
        .wrap { position: relative; height: 100%; width: 100%; }
        .err { color: #b00; padding: 8px; }
    </style>
</head>
<body>
<div class="wrap"><canvas id="chart"></canvas></div>
<script>
    // Multi-series chart: result = {title, labels: [...], datasets: [{label, data, type?, stack?, yAxisID?, color}], stacked, y2_title?}
    const result = {{ result | tojson }};
    if (result.error) {
        document.body.innerHTML = '<div class="err">' + result.error + '</div>';
    } else {
        const datasets = result.datasets.map(d => ({
            label: d.label, data: d.data, type: d.type || 'bar', stack: d.stack, yAxisID: d.yAxisID || 'y',
            backgroundColor: d.color, borderColor: d.color, borderWidth: d.type === 'line' ? 2 : 1,
            pointRadius: d.type === 'line' ? 2 : 0, tension: 0.2
        }));
        const scales = {
            x: { stacked: !!result.stacked, ticks: { autoSkip: true, maxRotation: 60 } },
            y: { stacked: !!result.stacked, beginAtZero: true, ticks: { precision: 0 }, title: { display: !!result.y_title, text: result.y_title } }
        };
        if (result.y2_title) {
            scales.y2 = { position: 'right', beginAtZero: true, grid: { drawOnChartArea: false }, title: { display: true, text: result.y2_title } };
        }
        new Chart(document.getElementById('chart').getContext('2d'), {
            type: 'bar',
            data: { labels: result.labels, datasets: datasets },
            options: { responsive: true, maintainAspectRatio: false, scales: scales,
                       plugins: { title: { display: true, text: result.title }, legend: { position: 'bottom' } } }
        });
    }
</script>
</body>
</html>
