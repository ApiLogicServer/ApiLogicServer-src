// Or, view in VSCode with extension: "DBML Live Preview"

Table Customer {
    id INTEGER [primary key]
    name VARCHAR 
    balance DECIMAL 
    credit_limit DECIMAL 
    email VARCHAR 
    email_opt_out BOOLEAN 
    }

Table DailyFlow {
    day TEXT [primary key]
    order_count INTEGER 
    order_amount NUMERIC(15, 2) 
    message_received INTEGER 
    message_processed INTEGER 
    message_rejected INTEGER 
    message_pending INTEGER 
    request_received INTEGER 
    request_processed INTEGER 
    request_rejected INTEGER 
    request_pending INTEGER 
    }

Table Item {
    id INTEGER [primary key]
    order_id INTEGER 
    product_id INTEGER 
    quantity INTEGER 
    amount DECIMAL 
    unit_price DECIMAL 
    }

Table Order {
    id INTEGER [primary key]
    notes VARCHAR 
    customer_id INTEGER 
    CreatedOn DATE 
    date_shipped DATE 
    amount_total DECIMAL 
    CreatedOnDay TEXT 
    }

Table Product {
    id INTEGER [primary key]
    name VARCHAR 
    count_suppliers INTEGER 
    unit_price DECIMAL 
    }

Table OrderB2bMessage {
    id INTEGER [primary key]
    CreatedOn DATETIME 
    CreatedOnDay TEXT 
    payload TEXT 
    is_processed BOOLEAN 
    error_text TEXT 
    }

Table OrderB2bRequest {
    id INTEGER [primary key]
    CreatedOn DATETIME 
    CreatedOnDay TEXT 
    payload TEXT 
    is_processed BOOLEAN 
    error_text TEXT 
    }

Table ProductSupplier {
    id INTEGER [primary key]
    product_id INTEGER 
    supplier_id INTEGER 
    supplier_part_number VARCHAR 
    unit_cost DECIMAL 
    lead_time_days INTEGER 
    }

Table Supplier {
    id INTEGER [primary key]
    name VARCHAR 
    contact_name VARCHAR 
    phone VARCHAR 
    email VARCHAR 
    region VARCHAR 
    }



// Relationships
    Ref: Item.(order_id) > Order.(id)
    Ref: Item.(product_id) > Product.(id)
    Ref: Order.(CreatedOnDay) > DailyFlow.(day)
    Ref: Order.(customer_id) > Customer.(id)
    Ref: OrderB2bMessage.(CreatedOnDay) > DailyFlow.(day)
    Ref: OrderB2bRequest.(CreatedOnDay) > DailyFlow.(day)
    Ref: ProductSupplier.(product_id) > Product.(id)
    Ref: ProductSupplier.(supplier_id) > Supplier.(id)
