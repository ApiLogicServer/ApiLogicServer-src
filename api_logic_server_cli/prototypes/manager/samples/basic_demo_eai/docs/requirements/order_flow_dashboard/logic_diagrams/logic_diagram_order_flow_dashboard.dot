digraph logic {
  graph [rankdir=TB, fontname="Helvetica", fontsize=13,
         label=<<B>Logic Diagram — demo_eai  [order_flow_dashboard]</B>>, labelloc=t,
         pad=0.4, nodesep=0.90, ranksep=1.10, bgcolor="white",
         splines=spline]
  node  [fontname="Helvetica", fontsize=11, shape=plaintext]
  edge  [fontname="Helvetica", fontsize=10]

  // ── trigger ─────────────────────────────────────────────────────
  TRIGGER [label=<<TABLE BORDER="2" CELLBORDER="0" CELLPADDING="5" BGCOLOR="#e8f5e9" COLOR="#27ae60"><TR><TD><FONT COLOR="#27ae60"><B>&#9889; OrderB2bRequest inserted</B></FONT></TD></TR></TABLE>>, shape=plaintext]

  // ── schema layer ──────────────────────────────────────────────────
  DailyFlow [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#4a6fa5"><TR><TD COLSPAN="3" BGCOLOR="#4a6fa5"><FONT COLOR="white"><B> DailyFlow </B></FONT></TD></TR><TR><TD PORT="DailyFlow_order_amount_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DailyFlow_order_amount" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> order_amount </FONT></TD><TD PORT="DailyFlow_order_amount_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DailyFlow_order_count_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DailyFlow_order_count" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> order_count </FONT></TD><TD PORT="DailyFlow_order_count_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DailyFlow_message_received_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DailyFlow_message_received" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> message_received </FONT></TD><TD PORT="DailyFlow_message_received_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DailyFlow_message_processed_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DailyFlow_message_processed" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> message_processed </FONT></TD><TD PORT="DailyFlow_message_processed_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DailyFlow_message_rejected_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DailyFlow_message_rejected" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> message_rejected </FONT></TD><TD PORT="DailyFlow_message_rejected_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DailyFlow_request_received_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DailyFlow_request_received" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> request_received </FONT></TD><TD PORT="DailyFlow_request_received_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DailyFlow_request_processed_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DailyFlow_request_processed" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> request_processed </FONT></TD><TD PORT="DailyFlow_request_processed_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DailyFlow_request_rejected_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DailyFlow_request_rejected" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> request_rejected </FONT></TD><TD PORT="DailyFlow_request_rejected_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DailyFlow_message_pending_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DailyFlow_message_pending" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> message_pending </FONT> <FONT COLOR="#e67e22" POINT-SIZE="9">= (message_received or 0) - (...</FONT></TD><TD PORT="DailyFlow_message_pending_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DailyFlow_request_pending_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DailyFlow_request_pending" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> request_pending </FONT> <FONT COLOR="#e67e22" POINT-SIZE="9">= (request_received or 0) - (...</FONT></TD><TD PORT="DailyFlow_request_pending_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR></TABLE>>]
  Order [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#4a6fa5"><TR><TD COLSPAN="3" BGCOLOR="#4a6fa5"><FONT COLOR="white"><B> Order </B></FONT></TD></TR><TR><TD PORT="Order_amount_total_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="Order_amount_total" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> amount_total </FONT></TD><TD PORT="Order_amount_total_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR></TABLE>>]
  OrderB2bMessage [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#4a6fa5"><TR><TD COLSPAN="3" BGCOLOR="#4a6fa5"><FONT COLOR="white"><B> OrderB2bMessage </B></FONT></TD></TR><TR><TD PORT="OrderB2bMessage_is_processed_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="OrderB2bMessage_is_processed" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> is_processed </FONT></TD><TD PORT="OrderB2bMessage_is_processed_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="OrderB2bMessage_error_text_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="OrderB2bMessage_error_text" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> error_text </FONT></TD><TD PORT="OrderB2bMessage_error_text_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR></TABLE>>]
  OrderB2bRequest [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#4a6fa5"><TR><TD COLSPAN="3" BGCOLOR="#4a6fa5"><FONT COLOR="white"><B> OrderB2bRequest </B></FONT></TD></TR><TR><TD PORT="OrderB2bRequest_is_processed_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="OrderB2bRequest_is_processed" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> is_processed </FONT></TD><TD PORT="OrderB2bRequest_is_processed_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="OrderB2bRequest_error_text_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="OrderB2bRequest_error_text" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> error_text </FONT></TD><TD PORT="OrderB2bRequest_error_text_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR></TABLE>>]
  // ── rank groupings ────────────────────────────────────────────────
  { rank=min; DailyFlow }
  { rank=max; Order; OrderB2bRequest; OrderB2bMessage; TRIGGER }

  // ── FK relationships ───────────────────────────────────────────
  Order -> DailyFlow [color="#e0e0e0", style=solid, arrowhead=none, arrowtail=crow, dir=both, penwidth=0.7, constraint=false, weight=1]
  OrderB2bMessage -> DailyFlow [color="#e0e0e0", style=solid, arrowhead=none, arrowtail=crow, dir=both, penwidth=0.7, constraint=false, weight=1]
  OrderB2bRequest -> DailyFlow [color="#e0e0e0", style=solid, arrowhead=none, arrowtail=crow, dir=both, penwidth=0.7, constraint=false, weight=1]

  // ── trigger edge ──────────────────────────────────────────────
  TRIGGER -> OrderB2bRequest [color="#27ae60", style=bold, arrowhead=vee, penwidth=2, weight=10]

  // ── logic edges ────────────────────────────────────────────────────
  // INTRA:DailyFlow:message_received:message_pending:1:0
  // INTRA:DailyFlow:request_received:request_pending:2:1
  Order:Order_amount_total_w -> DailyFlow:DailyFlow_order_amount_w [label="3", color="#444444", fontcolor="#444444", arrowhead=vee, penwidth=2, style=dashed, weight=8]
  Order -> DailyFlow:DailyFlow_order_count_w [label="4", color="#444444", fontcolor="#444444", arrowhead=vee, penwidth=2, style=dashed, weight=8, tailport=w]
  OrderB2bMessage -> DailyFlow:DailyFlow_message_received_w [label="5", color="#444444", fontcolor="#444444", arrowhead=vee, penwidth=2, style=dashed, weight=8, tailport=w]
  OrderB2bMessage -> DailyFlow:DailyFlow_message_processed_w [label="6", color="#444444", fontcolor="#444444", arrowhead=vee, penwidth=2, style=dashed, weight=8, tailport=w]
  OrderB2bMessage -> DailyFlow:DailyFlow_message_rejected_w [label="7", color="#444444", fontcolor="#444444", arrowhead=vee, penwidth=2, style=dashed, weight=8, tailport=w]
  OrderB2bRequest -> DailyFlow:DailyFlow_request_received_w [label="8", color="#444444", fontcolor="#444444", arrowhead=vee, penwidth=2, style=dashed, weight=8, tailport=w]
  OrderB2bRequest -> DailyFlow:DailyFlow_request_processed_w [label="9", color="#444444", fontcolor="#444444", arrowhead=vee, penwidth=2, style=dashed, weight=8, tailport=w]
  OrderB2bRequest -> DailyFlow:DailyFlow_request_rejected_w [label="10", color="#444444", fontcolor="#444444", arrowhead=vee, penwidth=2, style=dashed, weight=8, tailport=w]
}