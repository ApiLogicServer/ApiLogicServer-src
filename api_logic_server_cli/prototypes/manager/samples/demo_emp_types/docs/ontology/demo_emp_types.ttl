@prefix :     <https://apilogicserver.github.io/ontology/demo_emp_types#> .
@prefix gl:   <https://apilogicserver.github.io/ontology/genai-logic#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .

# =============================================================================
# Ontology: demo_emp_types  (OWL 2, Turtle)
# Source:   database/models.py (schema) + logic/logic_discovery/*.py (rules)
# Two parts: (1) domain model: classes, properties, type hierarchy
#            (2) governance: every rule as a linked gl:Rule individual
# =============================================================================

<https://apilogicserver.github.io/ontology/demo_emp_types> a owl:Ontology ;
    dct:title "demo_emp_types: Departments and Employees" ;
    rdfs:comment "Two independent classification axes on Employee (employment type, military status), with the business rules that govern them." ;
    owl:imports <https://apilogicserver.github.io/ontology/genai-logic> .

# ---- GenAI-Logic governance vocabulary (would ship once, shared by all projects) ----

<https://apilogicserver.github.io/ontology/genai-logic> a owl:Ontology ;
    rdfs:comment "Vocabulary for declaring enforced business rules (LogicBank) as linked governance artifacts." .

gl:Rule a owl:Class ; rdfs:comment "An enforced, declarative business rule. Fires on every commit, over every change path." .
gl:Derivation a owl:Class ; rdfs:subClassOf gl:Rule ; rdfs:comment "Rule that derives a property value." .
gl:Sum        a owl:Class ; rdfs:subClassOf gl:Derivation .
gl:Count      a owl:Class ; rdfs:subClassOf gl:Derivation .
gl:Formula    a owl:Class ; rdfs:subClassOf gl:Derivation .
gl:Copy       a owl:Class ; rdfs:subClassOf gl:Derivation ; rdfs:comment "Snapshot copy from a parent; not re-derived when the parent changes later." .
gl:Constraint a owl:Class ; rdfs:subClassOf gl:Rule ; rdfs:comment "Condition that must hold for every commit; violation rejects the transaction." .

gl:derives    a owl:ObjectProperty ; rdfs:domain gl:Derivation ; rdfs:range owl:DatatypeProperty ; rdfs:comment "The property this rule computes." .
gl:validates  a owl:ObjectProperty ; rdfs:domain gl:Constraint ; rdfs:range owl:Class ; rdfs:comment "The class whose instances this constraint governs." .
gl:dependsOn  a owl:ObjectProperty ; rdfs:domain gl:Rule ; rdfs:comment "A property the rule reads (its dependency-graph inputs)." .
gl:derivedBy  a owl:ObjectProperty ; rdfs:comment "Inverse view: the rule that computes this property." ; owl:inverseOf gl:derives .
gl:appliesToType a owl:ObjectProperty ; rdfs:domain gl:Rule ; rdfs:range owl:Class ; rdfs:comment "The subtype a rule is scoped to (type guard inside the rule)." .
gl:requirement a owl:AnnotationProperty ; rdfs:comment "Verbatim requirement text that drove the rule." .
gl:expression  a owl:AnnotationProperty ; rdfs:comment "The rule as declared." .
gl:errorMessage a owl:AnnotationProperty .
gl:sourceFile  a owl:AnnotationProperty .
gl:origin      a owl:AnnotationProperty ; rdfs:comment "'specified' = stated in the requirement; 'inferred' = added by the AI, logged in ad-libs.md." .

# =============================================================================
# PART 1: DOMAIN MODEL
# =============================================================================

:Department a owl:Class ; rdfs:label "Department" .
:LaborUnion a owl:Class ; rdfs:label "Labor Union" .
:SysConfig  a owl:Class ; rdfs:label "System Configuration" ;
    rdfs:comment "Singleton of global, runtime-configurable settings (rates and thresholds)." .
:Employee   a owl:Class ; rdfs:label "Employee" .
:Order      a owl:Class ; rdfs:label "Commission Order" ;
    rdfs:comment "Table commission_order. Named Order here per the requirement's wording." .

# ---- Type hierarchy, axis 1: employment type (discriminator employee.type; single-table inheritance) ----
# Defined classes: membership is inferred from the discriminator value, not asserted.

:SalariedEmployee a owl:Class ; rdfs:label "Salaried Employee" ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :Employee [ a owl:Restriction ; owl:onProperty :employeeType ; owl:hasValue "salaried" ] ) ] ;
    rdfs:subClassOf :Employee .

:HourlyEmployee a owl:Class ; rdfs:label "Hourly Employee" ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :Employee [ a owl:Restriction ; owl:onProperty :employeeType ; owl:hasValue "hourly" ] ) ] ;
    rdfs:subClassOf :Employee .

:CommissionedEmployee a owl:Class ; rdfs:label "Commissioned Employee" ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :Employee [ a owl:Restriction ; owl:onProperty :employeeType ; owl:hasValue "commissioned" ] ) ] ;
    rdfs:subClassOf :Employee .

[] a owl:AllDisjointClasses ; owl:members ( :SalariedEmployee :HourlyEmployee :CommissionedEmployee ) .

# ---- Type hierarchy, axis 2: military status (discriminator employee.military; independent of axis 1) ----
# Not disjoint with axis 1: an employee can be an HourlyEmployee AND a MilitaryEmployee.

:MilitaryEmployee a owl:Class ; rdfs:label "Military Employee" ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :Employee [ a owl:Restriction ; owl:onProperty :military ; owl:hasValue "yes" ] ) ] ;
    rdfs:subClassOf :Employee .

# ---- Discriminators ----

:employeeType a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :Employee ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "salaried" "hourly" "commissioned" ) ] ;
    rdfs:comment "Column employee.type. (JSON:API wire name is 'Type'.)" .
:military a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :Employee ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "yes" "no" ) ] ;
    rdfs:comment "Column employee.military." .

# ---- Relationships ----

:worksIn a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain :Employee ; rdfs:range :Department ;
    owl:inverseOf :hasEmployee ; rdfs:comment "employee.dept_id (required)." .
:hasEmployee a owl:ObjectProperty ; rdfs:domain :Department ; rdfs:range :Employee .

:memberOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :HourlyEmployee ; rdfs:range :LaborUnion ; owl:inverseOf :hasMember ;
    rdfs:comment "employee.union_id (optional). Domain HourlyEmployee: only hourly employees may belong to a union." .
:hasMember a owl:ObjectProperty ; rdfs:domain :LaborUnion ; rdfs:range :HourlyEmployee .

:soldBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Order ; rdfs:range :CommissionedEmployee ; owl:inverseOf :hasOrder ;
    rdfs:comment "commission_order.employee_id. Range CommissionedEmployee: only commissioned employees may have orders." .
:hasOrder a owl:ObjectProperty ; rdfs:domain :CommissionedEmployee ; rdfs:range :Order .

:governedBy a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain :Employee ; rdfs:range :SysConfig ;
    rdfs:comment "employee.sys_config_id. Source of copied thresholds/rates." .

# ---- Data properties (derived ones carry gl:derivedBy, linked to rules in Part 2) ----

:name a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:domain [ a owl:Class ; owl:unionOf ( :Department :LaborUnion :Employee ) ] .
:budget a owl:DatatypeProperty ; rdfs:domain :Department ; rdfs:range xsd:decimal .
:totalSalary a owl:DatatypeProperty ; rdfs:domain :Department ; rdfs:range xsd:decimal ; gl:derivedBy :rule_dept_total_salary .
:duesRate a owl:DatatypeProperty ; rdfs:domain :LaborUnion ; rdfs:range xsd:double .

:salary a owl:DatatypeProperty ; rdfs:domain :Employee ; rdfs:range xsd:decimal ;
    gl:derivedBy :rule_salary ; rdfs:comment "Derived for hourly and commissioned; entered directly for salaried." .
:totalCompensation a owl:DatatypeProperty ; rdfs:domain :Employee ; rdfs:range xsd:decimal ; gl:derivedBy :rule_total_compensation .
:maxHourlyWeeklySalary a owl:DatatypeProperty ; rdfs:domain :Employee ; rdfs:range xsd:decimal ; gl:derivedBy :rule_copy_max_hourly .

:hoursWorked a owl:DatatypeProperty ; rdfs:domain :HourlyEmployee ; rdfs:range xsd:double .
:hourlyRate  a owl:DatatypeProperty ; rdfs:domain :HourlyEmployee ; rdfs:range xsd:double .
:unionDues   a owl:DatatypeProperty ; rdfs:domain :HourlyEmployee ; rdfs:range xsd:decimal ; gl:derivedBy :rule_union_dues .

:baseSalary a owl:DatatypeProperty ; rdfs:domain :CommissionedEmployee ; rdfs:range xsd:decimal .
:commissionTotal a owl:DatatypeProperty ; rdfs:domain :CommissionedEmployee ; rdfs:range xsd:decimal ; gl:derivedBy :rule_commission_total .

:amount a owl:DatatypeProperty ; rdfs:domain :Order ; rdfs:range xsd:decimal .
:customerName a owl:DatatypeProperty ; rdfs:domain :Order ; rdfs:range xsd:string .

:branch a owl:DatatypeProperty ; rdfs:domain :MilitaryEmployee ;
    rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "Army" "Navy" "Air Force" "Marines" "Coast Guard" ) ] .
:rank a owl:DatatypeProperty ; rdfs:domain :MilitaryEmployee ; rdfs:range xsd:string .
:serviceYears a owl:DatatypeProperty ; rdfs:domain :MilitaryEmployee ; rdfs:range xsd:integer .
:militaryStipend a owl:DatatypeProperty ; rdfs:domain :Employee ; rdfs:range xsd:double ; gl:derivedBy :rule_military_stipend ;
    rdfs:comment "0 for non-military employees." .
:militaryStipendRatePerYear a owl:DatatypeProperty ; rdfs:domain [ a owl:Class ; owl:unionOf ( :SysConfig :Employee ) ] ;
    rdfs:range xsd:double ; gl:derivedBy :rule_copy_stipend_rate .

:maxHourlyWeeklySalaryConfig a owl:DatatypeProperty ; rdfs:domain :SysConfig ; rdfs:range xsd:decimal ;
    rdfs:comment "sys_config.max_hourly_weekly_salary (source of the copy)." .

# =============================================================================
# PART 2: GOVERNANCE, the rules that make the model true on every write
# =============================================================================

# ---------- department_budget.py ----------
:rule_dept_total_salary a gl:Sum ;
    rdfs:label "Department.total_salary = sum(Employee.salary)" ;
    gl:sourceFile "logic/logic_discovery/department_budget.py" ; gl:origin "specified" ;
    gl:requirement "Department.total_salary = sum of Employee.salary (all types)." ;
    gl:expression "Rule.sum(derive=Department.total_salary, as_sum_of=Employee.salary)" ;
    gl:derives :totalSalary ; gl:dependsOn :salary .

:rule_dept_budget a gl:Constraint ;
    rdfs:label "Department total_salary must not exceed budget" ;
    gl:sourceFile "logic/logic_discovery/department_budget.py" ; gl:origin "specified" ;
    gl:requirement "Department.total_salary must not exceed Department.budget." ;
    gl:expression "row.total_salary <= row.budget" ;
    gl:errorMessage "Department total_salary ({row.total_salary}) exceeds budget ({row.budget})" ;
    gl:validates :Department ; gl:dependsOn :totalSalary , :budget .

# ---------- employee_compensation.py ----------
:rule_copy_max_hourly a gl:Copy ;
    rdfs:label "Employee.max_hourly_weekly_salary copied from SysConfig" ;
    gl:sourceFile "logic/logic_discovery/employee_compensation.py" ; gl:origin "specified" ;
    gl:requirement "Hourly employees: salary must not exceed 5000 per week. (threshold lives in SysConfig, not a literal)" ;
    gl:expression "Rule.copy(derive=Employee.max_hourly_weekly_salary, from_parent=SysConfig.max_hourly_weekly_salary)" ;
    gl:derives :maxHourlyWeeklySalary ; gl:dependsOn :maxHourlyWeeklySalaryConfig .

:rule_salary a gl:Formula ;
    rdfs:label "Employee.salary, by employment type" ;
    gl:sourceFile "logic/logic_discovery/employee_compensation.py" ; gl:origin "specified" ;
    gl:requirement "Hourly employees: salary = hours_worked * hourly_rate. Commissioned employees: salary = base_salary + commission_total." ;
    gl:expression "hourly: hours_worked * hourly_rate; commissioned: base_salary + commission_total; salaried: entered" ;
    gl:derives :salary ; gl:appliesToType :HourlyEmployee , :CommissionedEmployee ;
    gl:dependsOn :employeeType , :hoursWorked , :hourlyRate , :baseSalary , :commissionTotal .

:rule_hourly_cap a gl:Constraint ;
    rdfs:label "Hourly salary must not exceed weekly cap" ;
    gl:sourceFile "logic/logic_discovery/employee_compensation.py" ; gl:origin "specified" ;
    gl:requirement "Hourly employees: salary must not exceed 5000 per week." ;
    gl:expression "row.type != 'hourly' or row.salary is None or row.salary <= row.max_hourly_weekly_salary" ;
    gl:errorMessage "Hourly salary ({row.salary}) exceeds weekly cap ({row.max_hourly_weekly_salary})" ;
    gl:validates :HourlyEmployee ; gl:dependsOn :salary , :maxHourlyWeeklySalary .

:rule_union_hourly_only a gl:Constraint ;
    rdfs:label "Only hourly employees may have a union" ;
    gl:sourceFile "logic/logic_discovery/employee_compensation.py" ; gl:origin "specified" ;
    gl:requirement "Hourly employees may be assigned to a Union (optional); only Hourly employees may have a union_id." ;
    gl:expression "row.type == 'hourly' or row.union_id is None" ;
    gl:errorMessage "union_id must be null for non-hourly employees" ;
    gl:validates :Employee ; gl:dependsOn :employeeType , :memberOf .

:rule_union_dues a gl:Formula ;
    rdfs:label "Hourly union_dues = hours_worked * union.dues_rate" ;
    gl:sourceFile "logic/logic_discovery/employee_compensation.py" ; gl:origin "specified" ;
    gl:requirement "Hourly employees: union_dues = hours_worked * union.dues_rate (0 if no union assigned)." ;
    gl:expression "0 unless hourly with a union; else hours_worked * union.dues_rate" ;
    gl:derives :unionDues ; gl:appliesToType :HourlyEmployee ;
    gl:dependsOn :employeeType , :memberOf , :hoursWorked , :duesRate .

:rule_commission_total a gl:Sum ;
    rdfs:label "Commissioned commission_total = sum(Order.amount)" ;
    gl:sourceFile "logic/logic_discovery/employee_compensation.py" ; gl:origin "specified" ;
    gl:requirement "Commissioned employees: commission_total = sum of Order.amount." ;
    gl:expression "Rule.sum(derive=Employee.commission_total, as_sum_of=CommissionOrder.amount)" ;
    gl:derives :commissionTotal ; gl:appliesToType :CommissionedEmployee ; gl:dependsOn :amount .

:rule_order_commissioned_only a gl:Constraint ;
    rdfs:label "Orders only for commissioned employees" ;
    gl:sourceFile "logic/logic_discovery/employee_compensation.py" ; gl:origin "specified" ;
    gl:requirement "Commissioned employees are employees who can have Orders; only Commissioned employees may have Orders." ;
    gl:expression "row.employee.type == 'commissioned'" ;
    gl:errorMessage "Orders can only be assigned to commissioned employees" ;
    gl:validates :Order ; gl:dependsOn :soldBy , :employeeType .

:rule_order_amount_positive a gl:Constraint ;
    rdfs:label "Order amount > 0" ;
    gl:sourceFile "logic/logic_discovery/employee_compensation.py" ; gl:origin "inferred" ;
    gl:requirement "(not stated; domain-standard validation added by the AI, see ad-libs.md)" ;
    gl:expression "row.amount > 0" ;
    gl:errorMessage "Order amount ({row.amount}) must be greater than 0" ;
    gl:validates :Order ; gl:dependsOn :amount .

:rule_null_hours a gl:Constraint ;
    rdfs:label "hours_worked null unless hourly" ; gl:origin "inferred" ;
    gl:sourceFile "logic/logic_discovery/employee_compensation.py" ;
    gl:requirement "(inferred from single-table inheritance: subtype columns are null for other types)" ;
    gl:expression "row.type == 'hourly' or row.hours_worked is None" ;
    gl:errorMessage "hours_worked must be null for non-hourly employees" ;
    gl:validates :Employee ; gl:dependsOn :employeeType , :hoursWorked .

:rule_null_rate a gl:Constraint ;
    rdfs:label "hourly_rate null unless hourly" ; gl:origin "inferred" ;
    gl:sourceFile "logic/logic_discovery/employee_compensation.py" ;
    gl:requirement "(inferred from single-table inheritance)" ;
    gl:expression "row.type == 'hourly' or row.hourly_rate is None" ;
    gl:errorMessage "hourly_rate must be null for non-hourly employees" ;
    gl:validates :Employee ; gl:dependsOn :employeeType , :hourlyRate .

:rule_null_base a gl:Constraint ;
    rdfs:label "base_salary null unless commissioned" ; gl:origin "inferred" ;
    gl:sourceFile "logic/logic_discovery/employee_compensation.py" ;
    gl:requirement "(inferred from single-table inheritance)" ;
    gl:expression "row.type == 'commissioned' or row.base_salary is None" ;
    gl:errorMessage "base_salary must be null for non-commissioned employees" ;
    gl:validates :Employee ; gl:dependsOn :employeeType , :baseSalary .

# ---------- military_classification.py ----------
:rule_copy_stipend_rate a gl:Copy ;
    rdfs:label "Employee.military_stipend_rate_per_year copied from SysConfig" ;
    gl:sourceFile "logic/logic_discovery/military_classification.py" ; gl:origin "specified" ;
    gl:requirement "Military employees receive a military_stipend (REAL) = service_years * 100. (the 100 lives in SysConfig)" ;
    gl:expression "Rule.copy(derive=Employee.military_stipend_rate_per_year, from_parent=SysConfig.military_stipend_rate_per_year)" ;
    gl:derives :militaryStipendRatePerYear .

:rule_military_stipend a gl:Formula ;
    rdfs:label "military_stipend = service_years * rate (military only, else 0)" ;
    gl:sourceFile "logic/logic_discovery/military_classification.py" ; gl:origin "specified" ;
    gl:requirement "Military employees receive a military_stipend (REAL) = service_years * 100." ;
    gl:expression "0 unless military == 'yes'; else service_years * military_stipend_rate_per_year" ;
    gl:derives :militaryStipend ; gl:appliesToType :MilitaryEmployee ;
    gl:dependsOn :military , :serviceYears , :militaryStipendRatePerYear .

:rule_total_compensation a gl:Formula ;
    rdfs:label "total_compensation = salary + military_stipend" ;
    gl:sourceFile "logic/logic_discovery/military_classification.py" ; gl:origin "specified" ;
    gl:requirement "Total compensation for military employees = salary + military_stipend. Total compensation for non-military employees = salary." ;
    gl:expression "salary + military_stipend (stipend is 0 for non-military, so one formula covers both)" ;
    gl:derives :totalCompensation ; gl:dependsOn :salary , :militaryStipend .

:rule_null_branch a gl:Constraint ;
    rdfs:label "branch null unless military" ; gl:origin "inferred" ;
    gl:sourceFile "logic/logic_discovery/military_classification.py" ;
    gl:requirement "(inferred from the military classification axis)" ;
    gl:expression "row.military == 'yes' or row.branch is None" ;
    gl:errorMessage "branch must be null for non-military employees" ;
    gl:validates :Employee ; gl:dependsOn :military , :branch .

:rule_null_rank a gl:Constraint ;
    rdfs:label "rank null unless military" ; gl:origin "inferred" ;
    gl:sourceFile "logic/logic_discovery/military_classification.py" ;
    gl:requirement "(inferred from the military classification axis)" ;
    gl:expression "row.military == 'yes' or row.rank is None" ;
    gl:errorMessage "rank must be null for non-military employees" ;
    gl:validates :Employee ; gl:dependsOn :military , :rank .

:rule_null_service_years a gl:Constraint ;
    rdfs:label "service_years null unless military" ; gl:origin "inferred" ;
    gl:sourceFile "logic/logic_discovery/military_classification.py" ;
    gl:requirement "(inferred from the military classification axis)" ;
    gl:expression "row.military == 'yes' or row.service_years is None" ;
    gl:errorMessage "service_years must be null for non-military employees" ;
    gl:validates :Employee ; gl:dependsOn :military , :serviceYears .

:rule_valid_branch a gl:Constraint ;
    rdfs:label "branch must be a recognized service branch" ;
    gl:sourceFile "logic/logic_discovery/military_classification.py" ; gl:origin "specified" ;
    gl:requirement "Military employees have a branch (TEXT: 'Army', 'Navy', 'Air Force', 'Marines', 'Coast Guard')" ;
    gl:expression "row.branch is None or row.branch in ('Army','Navy','Air Force','Marines','Coast Guard')" ;
    gl:errorMessage "branch ({row.branch}) is not a recognized military branch" ;
    gl:validates :MilitaryEmployee ; gl:dependsOn :branch .
