  "Shipment" [label=<<TABLE BORDER="1" COLOR="#d9d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#f2f2f2"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#3f6792"><FONT COLOR="white" POINT-SIZE="12"><B>Shipment</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>local_shipment_oid_nbr</B> <FONT POINT-SIZE="8" COLOR="#3f6792">PK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">awb_nbr&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT">base_charge_amt&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">DECIMAL</FONT></TD></TR><TR><TD ALIGN="LEFT">cargo_desc&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR(45)</FONT></TD></TR><TR><TD ALIGN="LEFT">cargo_qty&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">cash_in_advance_flg&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR(1)</FONT></TD></TR><TR><TD ALIGN="LEFT">ci_seq_nbr&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR(1)</FONT></TD></TR><TR><TD ALIGN="LEFT">comat_flg&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR(1)</FONT></TD></TR><TR><TD ALIGN="LEFT">consolidated_freight_flg&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR(1)</FONT></TD></TR><TR><TD ALIGN="LEFT">container_nbr&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT">contract_wgt_type_cd&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR(1)</FONT></TD></TR><TR><TD ALIGN="LEFT">create_dt&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT">csa_flg&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR(1)</