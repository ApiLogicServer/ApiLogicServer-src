  "Customer" [label=<<TABLE BORDER="1" COLOR="#d9d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#f2f2f2"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#3f6792"><FONT COLOR="white" POINT-SIZE="12"><B>Customer</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> <FONT POINT-SIZE="8" COLOR="#3f6792">PK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">name&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT">address1&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT">address2&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT">city&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT">state&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT">country&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR(3)</FONT></TD></TR><TR><TD ALIGN="LEFT">postal&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR(15)</FONT></TD></TR><TR><TD ALIGN="LEFT">business_nbr&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT">gst_reg&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT">duty_bill_to_acct_nbr&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">duty_bill_to_cd&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR(1)</FONT></TD></TR><TR><TD ALIGN="LEFT">payor_location&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">VARCHAR(5)</FONT></TD></TR><TR><TD ALIGN="LEFT">weight&nbsp