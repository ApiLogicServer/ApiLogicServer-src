digraph logic {
  graph [rankdir=TB, fontname="Helvetica", fontsize=13,
         label=<<B>Logic Diagram — erpnext_credit_modernized  [credit_check]</B>>, labelloc=t,
         pad=0.4, nodesep=0.90, ranksep=1.10, bgcolor="white",
         splines=spline]
  node  [fontname="Helvetica", fontsize=11, shape=plaintext]
  edge  [fontname="Helvetica", fontsize=10]

  // ── trigger ─────────────────────────────────────────────────────
  TRIGGER [label=<<TABLE BORDER="2" CELLBORDER="0" CELLPADDING="5" BGCOLOR="#e8f5e9" COLOR="#27ae60"><TR><TD><FONT COLOR="#27ae60"><B>&#9889; DeliveryNoteItem inserted</B></FONT></TD></TR></TABLE>>, shape=plaintext]

  // ── schema layer ──────────────────────────────────────────────────
  DeliveryNote [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#4a6fa5"><TR><TD COLSPAN="3" BGCOLOR="#4a6fa5"><FONT COLOR="white"><B> DeliveryNote </B></FONT></TD></TR><TR><TD PORT="DeliveryNote_uninvoiced_share_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DeliveryNote_uninvoiced_share" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> uninvoiced_share </FONT></TD><TD PORT="DeliveryNote_uninvoiced_share_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DeliveryNote_so_linked_uninvoiced_share_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DeliveryNote_so_linked_uninvoiced_share" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> so_linked_uninvoiced_share </FONT></TD><TD PORT="DeliveryNote_so_linked_uninvoiced_share_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DeliveryNote_unlinked_line_count_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DeliveryNote_unlinked_line_count" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> unlinked_line_count </FONT></TD><TD PORT="DeliveryNote_unlinked_line_count_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DeliveryNote_no_invoice_line_count_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DeliveryNote_no_invoice_line_count" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> no_invoice_line_count </FONT></TD><TD PORT="DeliveryNote_no_invoice_line_count_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DeliveryNote_bypass_extra_amount_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DeliveryNote_bypass_extra_amount" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> bypass_extra_amount </FONT> <FONT COLOR="#e67e22" POINT-SIZE="9">= _delivery_note_bypass_extra_amount(row)</FONT></TD><TD PORT="DeliveryNote_bypass_extra_amount_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DeliveryNote_docstatus_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DeliveryNote_docstatus" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> docstatus </FONT></TD><TD PORT="DeliveryNote_docstatus_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DeliveryNote_net_total_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DeliveryNote_net_total" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> net_total </FONT></TD><TD PORT="DeliveryNote_net_total_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DeliveryNote_grand_total_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DeliveryNote_grand_total" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> grand_total </FONT></TD><TD PORT="DeliveryNote_grand_total_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR></TABLE>>]
  DeliveryNoteItem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#4a6fa5"><TR><TD COLSPAN="3" BGCOLOR="#4a6fa5"><FONT COLOR="white"><B> DeliveryNoteItem </B></FONT></TD></TR><TR><TD PORT="DeliveryNoteItem_grand_total_share_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DeliveryNoteItem_grand_total_share" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> grand_total_share </FONT> <FONT COLOR="#e67e22" POINT-SIZE="9">= _delivery_line_grand_total_share(row)</FONT></TD><TD PORT="DeliveryNoteItem_grand_total_share_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DeliveryNoteItem_sales_order_id_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DeliveryNoteItem_sales_order_id" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> sales_order_id </FONT></TD><TD PORT="DeliveryNoteItem_sales_order_id_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DeliveryNoteItem_sales_invoice_id_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DeliveryNoteItem_sales_invoice_id" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> sales_invoice_id </FONT></TD><TD PORT="DeliveryNoteItem_sales_invoice_id_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DeliveryNoteItem_net_amount_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DeliveryNoteItem_net_amount" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> net_amount </FONT></TD><TD PORT="DeliveryNoteItem_net_amount_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DeliveryNoteItem_delivery_note_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DeliveryNoteItem_delivery_note" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> delivery_note </FONT></TD><TD PORT="DeliveryNoteItem_delivery_note_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR></TABLE>>]
  SalesInvoice [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#4a6fa5"><TR><TD COLSPAN="3" BGCOLOR="#4a6fa5"><FONT COLOR="white"><B> SalesInvoice </B></FONT></TD></TR><TR><TD PORT="SalesInvoice_unlinked_line_count_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="SalesInvoice_unlinked_line_count" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> unlinked_line_count </FONT></TD><TD PORT="SalesInvoice_unlinked_line_count_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR></TABLE>>]
  SalesInvoiceItem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#4a6fa5"><TR><TD COLSPAN="3" BGCOLOR="#4a6fa5"><FONT COLOR="white"><B> SalesInvoiceItem </B></FONT></TD></TR><TR><TD PORT="SalesInvoiceItem_sales_order_id_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="SalesInvoiceItem_sales_order_id" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> sales_order_id </FONT></TD><TD PORT="SalesInvoiceItem_sales_order_id_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="SalesInvoiceItem_delivery_note_item_id_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="SalesInvoiceItem_delivery_note_item_id" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> delivery_note_item_id </FONT></TD><TD PORT="SalesInvoiceItem_delivery_note_item_id_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR></TABLE>>]
  // ── rank groupings ────────────────────────────────────────────────
  { rank=min; SalesInvoice; DeliveryNote }
  { rank=same; DeliveryNoteItem; TRIGGER }
  { rank=max; SalesInvoiceItem }

  // ── FK relationships ───────────────────────────────────────────
  DeliveryNoteItem -> DeliveryNote [color="#e0e0e0", style=solid, arrowhead=none, arrowtail=crow, dir=both, penwidth=0.7, constraint=false, weight=1]
  DeliveryNoteItem -> SalesInvoice [color="#e0e0e0", style=solid, arrowhead=none, arrowtail=crow, dir=both, penwidth=0.7, constraint=false, weight=1]
  SalesInvoiceItem -> DeliveryNoteItem [color="#e0e0e0", style=solid, arrowhead=none, arrowtail=crow, dir=both, penwidth=0.7, constraint=false, weight=1]
  SalesInvoiceItem -> SalesInvoice [color="#e0e0e0", style=solid, arrowhead=none, arrowtail=crow, dir=both, penwidth=0.7, constraint=false, weight=1]

  // ── trigger edge ──────────────────────────────────────────────
  TRIGGER -> DeliveryNoteItem [color="#27ae60", style=bold, arrowhead=vee, penwidth=2, weight=10]

  // ── logic edges ────────────────────────────────────────────────────
  // INTRA:DeliveryNoteItem:delivery_note:grand_total_share:1:0
  // INTRA:DeliveryNote:uninvoiced_share:bypass_extra_amount:2:0
  // INTRA:DeliveryNote:grand_total:bypass_extra_amount:2:1
  SalesInvoiceItem -> SalesInvoice:SalesInvoice_unlinked_line_count_w [label="3", color="#444444", fontcolor="#444444", arrowhead=vee, penwidth=2, style=dashed, weight=8, tailport=w]
  DeliveryNoteItem:DeliveryNoteItem_grand_total_share_w -> DeliveryNote:DeliveryNote_uninvoiced_share_w [label="4", color="#444444", fontcolor="#444444", arrowhead=vee, penwidth=2, style=dashed, weight=8]
  DeliveryNoteItem:DeliveryNoteItem_grand_total_share_w -> DeliveryNote:DeliveryNote_so_linked_uninvoiced_share_w [label="5", color="#444444", fontcolor="#444444", arrowhead=vee, penwidth=2, style=dashed, weight=8]
  DeliveryNoteItem -> DeliveryNote:DeliveryNote_unlinked_line_count_w [label="6", color="#444444", fontcolor="#444444", arrowhead=vee, penwidth=2, style=dashed, weight=8, tailport=w]
  DeliveryNoteItem -> DeliveryNote:DeliveryNote_no_invoice_line_count_w [label="7", color="#444444", fontcolor="#444444", arrowhead=vee, penwidth=2, style=dashed, weight=8, tailport=w]
}