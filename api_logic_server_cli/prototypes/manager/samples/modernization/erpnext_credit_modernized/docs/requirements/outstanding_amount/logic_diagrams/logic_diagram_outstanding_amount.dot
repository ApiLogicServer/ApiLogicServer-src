digraph logic {
  graph [rankdir=LR, fontname="Helvetica", fontsize=13,
         label=<<B>Logic Diagram — erpnext_credit_modernized  [outstanding_amount]</B>>, labelloc=t,
         pad=0.4, nodesep=0.35, ranksep=0.70, bgcolor="white",
         splines=spline]
  node  [fontname="Helvetica", fontsize=11, shape=plaintext]
  edge  [fontname="Helvetica", fontsize=10]

  // ── trigger ─────────────────────────────────────────────────────
  TRIGGER [label=<<TABLE BORDER="2" CELLBORDER="0" CELLPADDING="5" BGCOLOR="#e8f5e9" COLOR="#27ae60"><TR><TD><FONT COLOR="#27ae60"><B>&#9889; SalesOrder inserted</B></FONT></TD></TR></TABLE>>, shape=plaintext]

  // ── schema layer ──────────────────────────────────────────────────
  CustomerCompany [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#4a6fa5"><TR><TD COLSPAN="3" BGCOLOR="#4a6fa5"><FONT COLOR="white"><B> CustomerCompany </B></FONT></TD></TR><TR><TD PORT="CustomerCompany_ledger_balance_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="CustomerCompany_ledger_balance" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> ledger_balance </FONT></TD><TD PORT="CustomerCompany_ledger_balance_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="CustomerCompany_open_sales_order_amount_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="CustomerCompany_open_sales_order_amount" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> open_sales_order_amount </FONT></TD><TD PORT="CustomerCompany_open_sales_order_amount_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="CustomerCompany_unbilled_delivery_amount_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="CustomerCompany_unbilled_delivery_amount" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> unbilled_delivery_amount </FONT></TD><TD PORT="CustomerCompany_unbilled_delivery_amount_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="CustomerCompany_outstanding_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="CustomerCompany_outstanding" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> outstanding </FONT> <FONT COLOR="#e67e22" POINT-SIZE="9">= (ledger_balance or 0) + (op...</FONT></TD><TD PORT="CustomerCompany_outstanding_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="CustomerCompany_outstanding_ignoring_sales_orders_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="CustomerCompany_outstanding_ignoring_sales_orders" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> outstanding_ignoring_sales_orders </FONT> <FONT COLOR="#e67e22" POINT-SIZE="9">= (ledger_balance or 0) + (un...</FONT></TD><TD PORT="CustomerCompany_outstanding_ignoring_sales_orders_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR></TABLE>>]
  DeliveryNote [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#4a6fa5"><TR><TD COLSPAN="3" BGCOLOR="#4a6fa5"><FONT COLOR="white"><B> DeliveryNote </B></FONT></TD></TR><TR><TD PORT="DeliveryNote_unbilled_line_total_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DeliveryNote_unbilled_line_total" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> unbilled_line_total </FONT></TD><TD PORT="DeliveryNote_unbilled_line_total_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DeliveryNote_unbilled_amount_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DeliveryNote_unbilled_amount" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> unbilled_amount </FONT> <FONT COLOR="#e67e22" POINT-SIZE="9">= _delivery_note_unbilled_amount(row)</FONT></TD><TD PORT="DeliveryNote_unbilled_amount_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DeliveryNote_docstatus_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DeliveryNote_docstatus" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> docstatus </FONT></TD><TD PORT="DeliveryNote_docstatus_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DeliveryNote_status_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DeliveryNote_status" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> status </FONT></TD><TD PORT="DeliveryNote_status_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DeliveryNote_net_total_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DeliveryNote_net_total" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> net_total </FONT></TD><TD PORT="DeliveryNote_net_total_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR></TABLE>>]
  DeliveryNoteItem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#4a6fa5"><TR><TD COLSPAN="3" BGCOLOR="#4a6fa5"><FONT COLOR="white"><B> DeliveryNoteItem </B></FONT></TD></TR><TR><TD PORT="DeliveryNoteItem_billed_qty_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DeliveryNoteItem_billed_qty" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> billed_qty </FONT></TD><TD PORT="DeliveryNoteItem_billed_qty_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DeliveryNoteItem_unbilled_amount_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DeliveryNoteItem_unbilled_amount" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> unbilled_amount </FONT> <FONT COLOR="#e67e22" POINT-SIZE="9">= _delivery_line_unbilled_amount(row)</FONT></TD><TD PORT="DeliveryNoteItem_unbilled_amount_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DeliveryNoteItem_sales_order_id_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DeliveryNoteItem_sales_order_id" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> sales_order_id </FONT></TD><TD PORT="DeliveryNoteItem_sales_order_id_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DeliveryNoteItem_sales_invoice_id_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DeliveryNoteItem_sales_invoice_id" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> sales_invoice_id </FONT></TD><TD PORT="DeliveryNoteItem_sales_invoice_id_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DeliveryNoteItem_qty_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DeliveryNoteItem_qty" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> qty </FONT></TD><TD PORT="DeliveryNoteItem_qty_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DeliveryNoteItem_returned_qty_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DeliveryNoteItem_returned_qty" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> returned_qty </FONT></TD><TD PORT="DeliveryNoteItem_returned_qty_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DeliveryNoteItem_net_amount_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DeliveryNoteItem_net_amount" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> net_amount </FONT></TD><TD PORT="DeliveryNoteItem_net_amount_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="DeliveryNoteItem_delivery_note_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="DeliveryNoteItem_delivery_note" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> delivery_note </FONT></TD><TD PORT="DeliveryNoteItem_delivery_note_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR></TABLE>>]
  LedgerEntry [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#4a6fa5"><TR><TD COLSPAN="3" BGCOLOR="#4a6fa5"><FONT COLOR="white"><B> LedgerEntry </B></FONT></TD></TR><TR><TD PORT="LedgerEntry_amount_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="LedgerEntry_amount" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> amount </FONT> <FONT COLOR="#e67e22" POINT-SIZE="9">= (debit or 0) - (credit or 0)</FONT></TD><TD PORT="LedgerEntry_amount_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="LedgerEntry_debit_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="LedgerEntry_debit" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> debit </FONT></TD><TD PORT="LedgerEntry_debit_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="LedgerEntry_credit_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="LedgerEntry_credit" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> credit </FONT></TD><TD PORT="LedgerEntry_credit_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR></TABLE>>]
  SalesInvoiceItem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#4a6fa5"><TR><TD COLSPAN="3" BGCOLOR="#4a6fa5"><FONT COLOR="white"><B> SalesInvoiceItem </B></FONT></TD></TR><TR><TD PORT="SalesInvoiceItem_qty_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="SalesInvoiceItem_qty" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> qty </FONT></TD><TD PORT="SalesInvoiceItem_qty_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="SalesInvoiceItem_counts_as_billed_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="SalesInvoiceItem_counts_as_billed" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> counts_as_billed </FONT> <FONT COLOR="#e67e22" POINT-SIZE="9">= _invoice_line_counts_as_billed(row)</FONT></TD><TD PORT="SalesInvoiceItem_counts_as_billed_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="SalesInvoiceItem_sales_invoice_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="SalesInvoiceItem_sales_invoice" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> sales_invoice </FONT></TD><TD PORT="SalesInvoiceItem_sales_invoice_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR></TABLE>>]
  SalesOrder [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#4a6fa5"><TR><TD COLSPAN="3" BGCOLOR="#4a6fa5"><FONT COLOR="white"><B> SalesOrder </B></FONT></TD></TR><TR><TD PORT="SalesOrder_open_amount_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="SalesOrder_open_amount" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> open_amount </FONT> <FONT COLOR="#e67e22" POINT-SIZE="9">= _sales_order_open_amount(row)</FONT></TD><TD PORT="SalesOrder_open_amount_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="SalesOrder_docstatus_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="SalesOrder_docstatus" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> docstatus </FONT></TD><TD PORT="SalesOrder_docstatus_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="SalesOrder_status_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="SalesOrder_status" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> status </FONT></TD><TD PORT="SalesOrder_status_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="SalesOrder_grand_total_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="SalesOrder_grand_total" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> grand_total </FONT></TD><TD PORT="SalesOrder_grand_total_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR><TR><TD PORT="SalesOrder_per_billed_w" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD><TD PORT="SalesOrder_per_billed" ALIGN="LEFT" BGCOLOR="#dbe4f0" CELLPADDING="3"><FONT COLOR="#1a1a2e"> per_billed </FONT></TD><TD PORT="SalesOrder_per_billed_e" WIDTH="6" HEIGHT="18" BGCOLOR="#b8cce8"> </TD></TR></TABLE>>]
  each_class [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#4a6fa5"><TR><TD COLSPAN="3" BGCOLOR="#4a6fa5"><FONT COLOR="white"><B> each_class </B></FONT></TD></TR><TR><TD></TD><TD BGCOLOR="#dbe4f0"><FONT COLOR="#1a1a2e">  </FONT></TD><TD></TD></TR></TABLE>>]
  // ── rank groupings ────────────────────────────────────────────────
  { rank=min; each_class; CustomerCompany }
  { rank=same; DeliveryNote; SalesOrder; LedgerEntry; TRIGGER }
  { rank=same; DeliveryNoteItem }
  { rank=max; SalesInvoiceItem }

  // ── FK relationships ───────────────────────────────────────────
  DeliveryNote -> CustomerCompany [color="#e0e0e0", style=solid, arrowhead=none, arrowtail=crow, dir=both, penwidth=0.7, constraint=false, weight=1]
  DeliveryNoteItem -> DeliveryNote [color="#e0e0e0", style=solid, arrowhead=none, arrowtail=crow, dir=both, penwidth=0.7, constraint=false, weight=1]
  DeliveryNoteItem -> SalesOrder [color="#e0e0e0", style=solid, arrowhead=none, arrowtail=crow, dir=both, penwidth=0.7, constraint=false, weight=1]
  SalesOrder -> CustomerCompany [color="#e0e0e0", style=solid, arrowhead=none, arrowtail=crow, dir=both, penwidth=0.7, constraint=false, weight=1]
  LedgerEntry -> CustomerCompany [color="#e0e0e0", style=solid, arrowhead=none, arrowtail=crow, dir=both, penwidth=0.7, constraint=false, weight=1]
  SalesInvoiceItem -> DeliveryNoteItem [color="#e0e0e0", style=solid, arrowhead=none, arrowtail=crow, dir=both, penwidth=0.7, constraint=false, weight=1]
  SalesInvoiceItem -> SalesOrder [color="#e0e0e0", style=solid, arrowhead=none, arrowtail=crow, dir=both, penwidth=0.7, constraint=false, weight=1]

  // ── trigger edge ──────────────────────────────────────────────
  TRIGGER -> SalesOrder [color="#27ae60", style=bold, arrowhead=vee, penwidth=2, weight=10]

  // ── logic edges ────────────────────────────────────────────────────
  // INTRA:LedgerEntry:credit:amount:1:0
  // INTRA:CustomerCompany:ledger_balance:outstanding:2:0
  // INTRA:CustomerCompany:ledger_balance:outstanding_ignoring_sales_orders:3:1
  // INTRA:SalesOrder:per_billed:open_amount:4:0
  // INTRA:SalesInvoiceItem:sales_invoice:counts_as_billed:5:0
  // INTRA:DeliveryNoteItem:billed_qty:unbilled_amount:6:0
  // INTRA:DeliveryNoteItem:delivery_note:unbilled_amount:6:1
  // INTRA:DeliveryNote:unbilled_line_total:unbilled_amount:7:0
  // INTRA:DeliveryNote:net_total:unbilled_amount:7:1
  SalesInvoiceItem:SalesInvoiceItem_qty_w -> DeliveryNoteItem:DeliveryNoteItem_billed_qty_w [label="8", color="#444444", fontcolor="#444444", arrowhead=vee, penwidth=2, style=dashed, weight=8]
  DeliveryNoteItem:DeliveryNoteItem_unbilled_amount_w -> DeliveryNote:DeliveryNote_unbilled_line_total_w [label="9", color="#444444", fontcolor="#444444", arrowhead=vee, penwidth=2, style=dashed, weight=8]
  LedgerEntry:LedgerEntry_amount_w -> CustomerCompany:CustomerCompany_ledger_balance_w [label="10", color="#444444", fontcolor="#444444", arrowhead=vee, penwidth=2, style=dashed, weight=8]
  SalesOrder:SalesOrder_open_amount_w -> CustomerCompany:CustomerCompany_open_sales_order_amount_w [label="11", color="#444444", fontcolor="#444444", arrowhead=vee, penwidth=2, style=dashed, weight=8]
  DeliveryNote:DeliveryNote_unbilled_amount_w -> CustomerCompany:CustomerCompany_unbilled_delivery_amount_w [label="12", color="#444444", fontcolor="#444444", arrowhead=vee, penwidth=2, style=dashed, weight=8]

  // ── events (right cluster) ─────────────────────────────────────
  subgraph cluster_events {
    style=invis
    evt__link_customer_company [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="4" BGCOLOR="#e8f5e9" COLOR="#27ae60"><TR><TD><FONT COLOR="#27ae60" POINT-SIZE="10">&#9889; _link_customer_company</FONT></TD></TR></TABLE>>, shape=plaintext]
  }
  each_class -> evt__link_customer_company [label="early", color="#27ae60", style=dashed, arrowhead=open, penwidth=1.2, fontcolor="#27ae60", constraint=false]
}