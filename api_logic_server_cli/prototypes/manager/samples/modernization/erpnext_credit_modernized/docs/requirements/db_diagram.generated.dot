digraph db {
  graph [rankdir=TB, bgcolor="#fbfbfb", pad=0.3, nodesep=0.6, ranksep=0.9, fontname="Helvetica"];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [color="#9b9ca4", penwidth=1.2, dir=both, arrowtail=tee, arrowhead=crow, arrowsize=0.8];
