  "CustomerGroup" [label=<<TABLE BORDER="1" COLOR="#d9d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#f2f2f2"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#3f6792"><FONT COLOR="white" POINT-SIZE="12"><B>CustomerGroup</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> <FONT POINT-SIZE="8" COLOR="#3f6792">PK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">name&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">TEXT</FONT></TD></TR></TABLE>>];
  "CustomerCompany" [label=<<TABLE BORDER="1" COLOR="#d9d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#f2f2f2"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#3f6792"><FONT COLOR="white" POINT-SIZE="12"><B>CustomerCompany</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> <FONT POINT-SIZE="8" COLOR="#3f6792">PK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">customer_id <FONT POINT-SIZE="8" COLOR="#3f6792">FK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">company_id <FONT POINT-SIZE="8" COLOR="#3f6792">FK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbe6f3">ledger_balance <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#dbe6f3"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbe6f3">open_sales_order_amount <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#dbe6f3"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbe6f3">unbilled_delivery_amount <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#dbe6f3"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbe6f3">outstanding <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#dbe6f3"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbe6f3">outstanding_ignoring_sales_orders <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#dbe6f3"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbe6f3">customer_credit_limit <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#dbe6f3"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbe6f3">bypass_credit_limit_check <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#dbe6f3"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR></TABLE>>];
  "CustomerCreditLimit" [label=<<TABLE BORDER="1" COLOR="#d9d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#f2f2f2"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#3f6792"><FONT COLOR="white" POINT-SIZE="12"><B>CustomerCreditLimit</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> <FONT POINT-SIZE="8" COLOR="#3f6792">PK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">customer_id <FONT POINT-SIZE="8" COLOR="#3f6792">FK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">company_id <FONT POINT-SIZE="8" COLOR="#3f6792">FK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">customer_company_id <FONT POINT-SIZE="8" COLOR="#3f6792">FK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">credit_limit&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,</FONT></TD></TR><TR><TD ALIGN="LEFT">bypass_credit_limit_check&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR></TABLE>>];
