mount <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#dbe6f3"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbe6f3">unlinked_line_count <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#dbe6f3"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbe6f3">no_invoice_line_count <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#dbe6f3"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbe6f3">uninvoiced_share <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#dbe6f3"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbe6f3">bypass_extra_amount <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#dbe6f3"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbe6f3">so_linked_uninvoiced_share <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#dbe6f3"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,</FONT></TD></TR></TABLE>>];
  "DeliveryNoteItem" [label=<<TABLE BORDER="1" COLOR="#d9d9d9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#f2f2f2"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#3f6792"><FONT COLOR="white" POINT-SIZE="12"><B>DeliveryNoteItem</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B> <FONT POINT-SIZE="8" COLOR="#3f6792">PK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">delivery_note_id <FONT POINT-SIZE="8" COLOR="#3f6792">FK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">qty&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,</FONT></TD></TR><TR><TD ALIGN="LEFT">returned_qty&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,</FONT></TD></TR><TR><TD ALIGN="LEFT">net_amount&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,</FONT></TD></TR><TR><TD ALIGN="LEFT">sales_order_id <FONT POINT-SIZE="8" COLOR="#3f6792">FK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">sales_invoice_id <FONT POINT-SIZE="8" COLOR="#3f6792">FK</FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#777777">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbe6f3">billed_qty <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#dbe6f3"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbe6f3">unbilled_amount <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#dbe6f3"><FONT POINT-SIZE="9" COLOR="#777777">NUMERIC(15,</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#dbe6f3">grand_total_share <FONT POINT-SIZE="8" COLOR="#777777"><I>derived</I></FONT>&nbsp;&nbsp;</TD><TD ALIGN="RIGHT" BGCOLOR="#dbe6f3"><FONT POINT-SIZE="9" 