{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "API Logic Server Run (run project from manager)",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/${input:runProjectName}",
            "env": {
                "PYTHONHASHSEED": "0",
                "APILOGICSERVER_DEBUG": "False",
                "OPT_LOCKING": "optional"},
            "justMyCode": false,
            "program": "api_logic_server_run.py",
            "redirectOutput": true,
            "console": "integratedTerminal",
            "internalConsoleOptions": "openOnSessionStart",
            "serverReadyAction": {
                "action": "openIntegratedBrowser",
                "pattern": "http://localhost:(\\d+)"
            }
        },
        {
            "name": "1. Create basic_demo project (from sqlite)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/venv/lib/python3.13/site-packages/api_logic_server_cli/cli.py",
            "redirectOutput": true,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "", 
                "SECURITY_ENABLED": "False", 
                "PYTHONHASHSEED": "0", 
                "APILOGICSERVER_DEBUG": "False",
                "OPT_LOCKING": "optional",
                "APILOGICSERVER_AUTO_OPEN": "NO_AUTO_OPEN"},
            "justMyCode": false,
            "args": [ "create", "--project-name=basic_demo",
                "--db-url=sqlite:///samples/dbs/basic_demo.sqlite"],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "name": "ApiLogicServer Create",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/venv/lib/python3.13/site-packages/api_logic_server_cli/cli.py",
            "redirectOutput": true,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "", 
                "SECURITY_ENABLED": "False", 
                "PYTHONHASHSEED": "0", 
                "APILOGICSERVER_DEBUG": "False",
                "OPT_LOCKING": "optional",
                "APILOGICSERVER_AUTO_OPEN": "NO_AUTO_OPEN"},
            "justMyCode": false,
            "args": [ "create",
                "--project-name=${input:inputProjectName}",
                "--db-url=${input:inputDBURL}"],
            "console": "internalConsole",
            "internalConsoleOptions": "openOnSessionStart"
        },
        {
            "name": "  - ApiLogicServer Create nw_sample_nocust",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/venv/lib/python3.13/site-packages/api_logic_server_cli/cli.py",
            "redirectOutput": true,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "", 
                "PYTHONHASHSEED": "0", 
                "APILOGICSERVER_DEBUG": "True",
                "OPT_LOCKING": "optional",
                "APILOGICSERVER_AUTO_OPEN": "NO_AUTO_OPEN"},
            "justMyCode": false,
            "args": [ "create",
                "--project-name=samples/nw_sample_nocust",
                "--db-url=nw"],
            "console": "internalConsole",
            "internalConsoleOptions": "openOnSessionStart"
        },
        {
            "name": "  - ApiLogicServer Create nw_sample With Customizations",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/venv/lib/python3.13/site-packages/api_logic_server_cli/cli.py",
            "redirectOutput": true,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "", 
                "PYTHONHASHSEED": "0", 
                "APILOGICSERVER_DEBUG": "True",
                "OPT_LOCKING": "optional",
                "APILOGICSERVER_AUTO_OPEN": "NO_AUTO_OPEN"},
            "justMyCode": false,
            "args": [ "create",
                "--project-name=samples/nw_sample",
                "--db-url=nw+"],
            "console": "internalConsole",
            "internalConsoleOptions": "openOnSessionStart"
        },
        {
            "name": "Python: Module",
            "type": "debugpy",
            "request": "launch",
            "redirectOutput": true,
            "justMyCode": false,            
            "module": "enter-your-module-name"
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "redirectOutput": true,
            "justMyCode": false,            
            "console": "internalConsole"
        },
        {
            "name": "Sys Info",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "samples/nw_sample/venv_setup/py.py",
            "redirectOutput": true,
            "args": ["sys-info"],
            "justMyCode": false,
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "inputProjectName",
            "type": "promptString",
            "description": "Project Name (will create directory with this name)",
            "default": "nw"
        },
        {
            "id": "runProjectName",
            "type": "promptString",
            "description": "Project Name (folder) to run",
            "default": "basic_demo"
        },
        {
            "id": "inputDBURL",
            "type": "promptString",
            "description": "Database URL (SQLAlchemy URI)",
            "default": "sqlite:///nw.sqlite"
        }
    ]
  }
