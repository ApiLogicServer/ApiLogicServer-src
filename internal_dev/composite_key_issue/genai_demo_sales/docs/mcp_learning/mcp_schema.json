{
    "tool_type": "json-api",
    "schema_version": "1.0",
    "base_url": "http://localhost:5656/api",
    "description": "API Logic Project: genai_demo_sales",
    "resources": [
        {
            "name": "Customer",
            "path": "/Customer",
            "methods": [
                "GET",
                "PATCH",
