            "path": "/Item",
            "methods": [
                "GET",
                "PATCH",
                "POST",
                "DELETE"
            ],
            "fields": [
                "id",
                "order_id",
                "product_id",
                "quantity",
                "unit_price",
                "amount"
            ],
            "filterable": [
                "id",
                "order_id",
                "product_id",
                "quantity",
                "unit_price",
                "amount"
            ]
        },
        {
